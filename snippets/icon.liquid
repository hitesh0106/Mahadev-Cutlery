{%- comment -%}
  Renders a named inline SVG icon.
  Accepts:
  - name: {String} Icon name (search, cart, heart, heart-filled, user, menu, close, chevron, whatsapp, gift, instagram, arrow)
  - class: {String} (optional) extra CSS class
  - size: {Number} (optional) pixel size, default 22
{%- endcomment -%}
{%- assign ic = name | default: 'circle' -%}
{%- assign isz = size | default: 22 -%}
{%- assign icls = 'mc-icon' -%}
{%- if class != blank -%}{%- assign icls = icls | append: ' ' | append: class -%}{%- endif -%}
<svg class="{{ icls }}" width="{{ isz }}" height="{{ isz }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case ic -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"></circle>
      <line x1="21" y1="21" x2="16.2" y2="16.2"></line>
    {%- when 'cart' -%}
      <path d="M3 4h2l2.4 12.2a1.5 1.5 0 0 0 1.5 1.3h8.6a1.5 1.5 0 0 0 1.5-1.2L21 8H6"></path>
      <circle cx="9.5" cy="20.5" r="1.2"></circle>
      <circle cx="17.5" cy="20.5" r="1.2"></circle>
    {%- when 'heart' -%}
      <path d="M12 20.3 4.9 13a4.7 4.7 0 0 1 0-6.6 4.5 4.5 0 0 1 6.5 0l.6.7.6-.7a4.5 4.5 0 0 1 6.5 0 4.7 4.7 0 0 1 0 6.6Z"></path>
    {%- when 'heart-filled' -%}
      <path d="M12 20.3 4.9 13a4.7 4.7 0 0 1 0-6.6 4.5 4.5 0 0 1 6.5 0l.6.7.6-.7a4.5 4.5 0 0 1 6.5 0 4.7 4.7 0 0 1 0 6.6Z" fill="currentColor" stroke="none"></path>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"></circle>
      <path d="M4.5 20.5a7.5 7.5 0 0 1 15 0"></path>
    {%- when 'menu' -%}
      <line x1="3.5" y1="6.5" x2="20.5" y2="6.5"></line>
      <line x1="3.5" y1="12" x2="20.5" y2="12"></line>
      <line x1="3.5" y1="17.5" x2="20.5" y2="17.5"></line>
    {%- when 'close' -%}
      <line x1="5.5" y1="5.5" x2="18.5" y2="18.5"></line>
      <line x1="18.5" y1="5.5" x2="5.5" y2="18.5"></line>
    {%- when 'chevron' -%}
      <polyline points="8.5 4.5 16 12 8.5 19.5"></polyline>
    {%- when 'whatsapp' -%}
      <path d="M12 3.8a8.2 8.2 0 0 0-7 12.4L3.8 20l3.9-1.1A8.2 8.2 0 1 0 12 3.8Z"></path>
      <path d="M8.8 8.6c.2-.5.4-.5.7-.5h.5c.2 0 .4 0 .6.5l.7 1.7c.1.2 0 .4-.1.6l-.5.6c-.1.2-.2.4 0 .7a6.5 6.5 0 0 0 2.9 2.5c.3.1.5.1.7-.1l.6-.7c.2-.2.4-.3.6-.2l1.7.8c.3.1.5.3.5.5a2 2 0 0 1-1.4 1.9 3.4 3.4 0 0 1-2.2-.2 10.5 10.5 0 0 1-5-4.4 3.9 3.9 0 0 1-.8-2.4Z"></path>
    {%- when 'gift' -%}
      <rect x="4" y="9" width="16" height="4"></rect>
      <rect x="5.5" y="13" width="13" height="7.5"></rect>
      <line x1="12" y1="9" x2="12" y2="20.5"></line>
      <path d="M12 9S9 9 8 8a2.1 2.1 0 0 1 3-3c1.2 1.2 1 4 1 4Z"></path>
      <path d="M12 9s3 0 4-1a2.1 2.1 0 0 0-3-3c-1.2 1.2-1 4-1 4Z"></path>
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"></circle>
    {%- when 'arrow' -%}
      <line x1="4" y1="12" x2="19" y2="12"></line>
      <polyline points="13 6 19 12 13 18"></polyline>
    {%- when 'map-pin' -%}
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
      <circle cx="12" cy="10" r="3"></circle>
    {%- when 'phone' -%}
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    {%- when 'mail' -%}
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
      <polyline points="22 6 12 13 2 6"></polyline>
    {%- else -%}
      <circle cx="12" cy="12" r="8"></circle>
  {%- endcase -%}
</svg>
