{%- comment -%}
  Featured brands — horizontally scrollable card carousel.
  Each brand block has: name, description, logo/image, collection picker,
  optional custom link, category collection links (up to 4), enable/disable.

  Link priority for main card:
    1. Collection picker → collection.url
    2. Custom link
    3. /pages/brands (generic fallback)

  Each category sub-link has its own independent collection picker.
  Blocks without a name are skipped. Disabled blocks are hidden.
{%- endcomment -%}
{%- liquid
  assign fb_rendered = 0
  for block in section.blocks
    if block.settings.name != blank and block.settings.enabled
      assign fb_rendered = fb_rendered | plus: 1
    endif
  endfor
-%}
  <section class="mc-section mc-section--soft mc-fbrands" data-mc-carousel>
    <div class="mc-container">
      <div class="mc-section__head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="mc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="mc-section__heading mc-section__heading--flush">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.action_label != blank -%}
          <a class="mc-action-link" href="{{ section.settings.action_link | default: '/pages/brands' }}">
            {{ section.settings.action_label | escape }}
            <svg class="mc-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div
      class="mc-fbrands__scroller no-scrollbar"
      data-mc-carousel-track
      tabindex="0"
      aria-label="{{ section.settings.heading | default: 'Featured brands' | escape }}"
    >
      {%- if fb_rendered > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign fb_name = block.settings.name -%}
          {%- if fb_name == blank or block.settings.enabled == false -%}{%- continue -%}{%- endif -%}
          {%- liquid
            if block.settings.brand_page != blank
              assign fb_href = block.settings.brand_page.url
            elsif block.settings.collection != blank
              assign fb_href = block.settings.collection.url
            elsif block.settings.link != blank
              assign fb_href = block.settings.link
            elsif block.settings.handle != blank
              assign fb_href = '/collections/' | append: block.settings.handle
            else
              assign fb_href = '/pages/brands'
            endif
          -%}
          {%- comment -%} Category quick links {%- endcomment -%}
          {%- liquid
            assign has_categories = false
            if block.settings.cat_1_label != blank or block.settings.cat_2_label != blank or block.settings.cat_3_label != blank or block.settings.cat_4_label != blank
              assign has_categories = true
            endif
          -%}
          {%- if has_categories -%}
            <div class="mc-fbrand mc-fbrand--has-categories" {{ block.shopify_attributes }}>
              <a class="mc-fbrand__head-link" href="{{ fb_href }}">
                {%- if block.settings.image != blank -%}
                  <span class="mc-fbrand__logo">
                    {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', class: 'mc-fbrand__logo-img', alt: fb_name | escape }}
                  </span>
                {%- endif -%}
                <span class="mc-fbrand__name">{{ fb_name | escape }}</span>
                {%- if block.settings.description != blank -%}
                  <span class="mc-fbrand__note">{{ block.settings.description | escape }}</span>
                {%- elsif block.settings.note != blank -%}
                  <span class="mc-fbrand__note">{{ block.settings.note | escape }}</span>
                {%- endif -%}
              </a>

              <div class="mc-fbrand__categories">
                {%- if block.settings.cat_1_label != blank -%}
                  {%- assign cat1_href = '' -%}
                  {%- if block.settings.cat_1_collection != blank -%}
                    {%- assign cat1_href = block.settings.cat_1_collection.url -%}
                  {%- elsif block.settings.cat_1_link != blank -%}
                    {%- assign cat1_href = block.settings.cat_1_link -%}
                  {%- endif -%}
                  {%- if cat1_href != blank -%}
                    <a class="mc-fbrand__cat-link" href="{{ cat1_href }}">{{ block.settings.cat_1_label | escape }}</a>
                  {%- else -%}
                    <span class="mc-fbrand__cat-static">{{ block.settings.cat_1_label | escape }}</span>
                  {%- endif -%}
                {%- endif -%}

                {%- if block.settings.cat_2_label != blank -%}
                  {%- assign cat2_href = '' -%}
                  {%- if block.settings.cat_2_collection != blank -%}
                    {%- assign cat2_href = block.settings.cat_2_collection.url -%}
                  {%- elsif block.settings.cat_2_link != blank -%}
                    {%- assign cat2_href = block.settings.cat_2_link -%}
                  {%- endif -%}
                  {%- if cat2_href != blank -%}
                    <a class="mc-fbrand__cat-link" href="{{ cat2_href }}">{{ block.settings.cat_2_label | escape }}</a>
                  {%- else -%}
                    <span class="mc-fbrand__cat-static">{{ block.settings.cat_2_label | escape }}</span>
                  {%- endif -%}
                {%- endif -%}

                {%- if block.settings.cat_3_label != blank -%}
                  {%- assign cat3_href = '' -%}
                  {%- if block.settings.cat_3_collection != blank -%}
                    {%- assign cat3_href = block.settings.cat_3_collection.url -%}
                  {%- elsif block.settings.cat_3_link != blank -%}
                    {%- assign cat3_href = block.settings.cat_3_link -%}
                  {%- endif -%}
                  {%- if cat3_href != blank -%}
                    <a class="mc-fbrand__cat-link" href="{{ cat3_href }}">{{ block.settings.cat_3_label | escape }}</a>
                  {%- else -%}
                    <span class="mc-fbrand__cat-static">{{ block.settings.cat_3_label | escape }}</span>
                  {%- endif -%}
                {%- endif -%}

                {%- if block.settings.cat_4_label != blank -%}
                  {%- assign cat4_href = '' -%}
                  {%- if block.settings.cat_4_collection != blank -%}
                    {%- assign cat4_href = block.settings.cat_4_collection.url -%}
                  {%- elsif block.settings.cat_4_link != blank -%}
                    {%- assign cat4_href = block.settings.cat_4_link -%}
                  {%- endif -%}
                  {%- if cat4_href != blank -%}
                    <a class="mc-fbrand__cat-link" href="{{ cat4_href }}">{{ block.settings.cat_4_label | escape }}</a>
                  {%- else -%}
                    <span class="mc-fbrand__cat-static">{{ block.settings.cat_4_label | escape }}</span>
                  {%- endif -%}
                {%- endif -%}
              </div>

              <a class="mc-fbrand__shop" href="{{ fb_href }}">
                {{ section.settings.card_cta_label | default: 'Shop' | escape }}
                <svg class="mc-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          {%- else -%}
            <a
              class="mc-fbrand"
              href="{{ fb_href }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                <span class="mc-fbrand__logo">
                  {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', class: 'mc-fbrand__logo-img', alt: fb_name | escape }}
                </span>
              {%- endif -%}
              <span class="mc-fbrand__name">{{ fb_name | escape }}</span>
              {%- if block.settings.description != blank -%}
                <span class="mc-fbrand__note">{{ block.settings.description | escape }}</span>
              {%- elsif block.settings.note != blank -%}
                <span class="mc-fbrand__note">{{ block.settings.note | escape }}</span>
              {%- endif -%}
              <span class="mc-fbrand__shop">
                {{ section.settings.card_cta_label | default: 'Shop' | escape }}
                <svg class="mc-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Guaranteed canonical brands fallback from Part 2 {%- endcomment -%}
        {%- assign fb_defaults = "Jockey:jockey:Innerwear & Socks,Van Heusen:van-heusen:Innerwear & Loungewear,Zoiro:zoiro:Men's innerwear only,Bodycare:bodycare:Women's & children's,Lady Care:lady-care:Women's nikar & panty,Swiss Beauty:swiss-beauty:Cosmetics & tools,Lakmé:lakme:Cosmetics & skincare,Maybelline New York:maybelline-new-york:Cosmetics,Faces Canada:faces-canada:Cosmetics & tools,Colorbar:colorbar:Cosmetics & nail care,MARS Cosmetics:mars-cosmetics:Beauty & makeup,Minimalist:minimalist:Skincare routines,Dot & Key:dot-key:Skincare & serums,Cetaphil:cetaphil:Gentle skincare,Sebamed:sebamed:Skincare & cleansers,POND'S:ponds:Skincare & face wash,NIVEA:nivea:Body care & skincare,Garnier:garnier:Skincare & haircare,Pilgrim:pilgrim:Skincare & haircare,Plix:plix:Skincare & wellness,Lotus Herbals:lotus-herbals:Skincare & sun protection,L'Oréal Paris:loreal-paris:Haircare, skincare & makeup,L'Oréal Professionnel:loreal-professionnel:Professional salon haircare,Matrix:matrix:Professional haircare,Wella Professionals:wella-professionals:Professional haircare,VEGA:vega:Hair & grooming tools,Philips:philips:Grooming appliances,Sunny:sunny:Innerwear & store favourites,Ghar Soaps:ghar-soaps:Personal care soaps" | split: ',' -%}
        {%- for item in fb_defaults -%}
          {%- assign parts = item | split: ':' -%}
          {%- assign b_name = parts[0] -%}
          {%- assign b_handle = parts[1] -%}
          {%- assign b_note = parts[2] -%}
          <a class="mc-fbrand" href="{{ routes.collections_url }}/{{ b_handle }}">
            <span class="mc-fbrand__name">{{ b_name | escape }}</span>
            {%- if b_note != blank -%}
              <span class="mc-fbrand__note">{{ b_note | escape }}</span>
            {%- endif -%}
            <span class="mc-fbrand__shop">
              {{ section.settings.card_cta_label | default: 'Shop' | escape }}
              <svg class="mc-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="mc-container mc-fbrands__nav">
      <button type="button" class="mc-carousel-arrow" data-mc-carousel-prev aria-label="{{ 'general.previous' | t }}">
        <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button type="button" class="mc-carousel-arrow" data-mc-carousel-next aria-label="{{ 'general.next' | t }}">
        <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </section>

  <script>
    (function () {
      'use strict';
      var sectionEl = document.currentScript.previousElementSibling;
      var track = sectionEl && sectionEl.querySelector('[data-mc-carousel-track]');
      if (!track || track.dataset.mcCarouselReady) return;
      track.dataset.mcCarouselReady = '1';
      var step = function () { return Math.max(track.clientWidth * 0.7, 240); };
      sectionEl.querySelector('[data-mc-carousel-prev]').addEventListener('click', function () {
        track.scrollBy({ left: -step(), behavior: 'smooth' });
      });
      sectionEl.querySelector('[data-mc-carousel-next]').addEventListener('click', function () {
        track.scrollBy({ left: step(), behavior: 'smooth' });
      });
    })();
  </script>


{% schema %}
{
  "name": "Featured brands",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Brands we stock"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured brands"
    },
    {
      "type": "text",
      "id": "action_label",
      "label": "Header action label",
      "default": "All brands A–Z"
    },
    {
      "type": "url",
      "id": "action_link",
      "label": "Header action link",
      "info": "Defaults to /pages/brands."
    },
    {
      "type": "text",
      "id": "card_cta_label",
      "label": "Card footer label",
      "default": "Shop"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand card",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this brand",
          "default": true
        },
        {
          "type": "text",
          "id": "name",
          "label": "Brand name"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Brand description / category",
          "info": "E.g. Cosmetics & skincare, Men's innerwear only, Professional haircare"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Brand logo / image (optional)"
        },
        {
          "type": "page",
          "id": "brand_page",
          "label": "Dedicated brand landing page (optional)",
          "info": "Link directly to the brand's dedicated landing page (e.g. /pages/brand-jockey)."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Brand collection",
          "info": "Select the Shopify collection for this brand. Each brand card gets its own independent collection."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (fallback)",
          "info": "Used when no collection is selected. E.g. a brand landing page."
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Collection handle (legacy fallback)",
          "info": "Used when neither collection nor custom link is set. E.g. lakme → /collections/lakme."
        },
        {
          "type": "text",
          "id": "note",
          "label": "One-line note (legacy, use description instead)",
          "info": "Kept for backwards compatibility."
        },
        {
          "type": "header",
          "content": "Category links (optional)"
        },
        {
          "type": "text",
          "id": "cat_1_label",
          "label": "Category 1 label",
          "info": "E.g. Face Makeup, Men's Innerwear"
        },
        {
          "type": "collection",
          "id": "cat_1_collection",
          "label": "Category 1 collection",
          "info": "Independent collection for this brand's first category."
        },
        {
          "type": "url",
          "id": "cat_1_link",
          "label": "Category 1 custom link (fallback)"
        },
        {
          "type": "text",
          "id": "cat_2_label",
          "label": "Category 2 label"
        },
        {
          "type": "collection",
          "id": "cat_2_collection",
          "label": "Category 2 collection"
        },
        {
          "type": "url",
          "id": "cat_2_link",
          "label": "Category 2 custom link (fallback)"
        },
        {
          "type": "text",
          "id": "cat_3_label",
          "label": "Category 3 label"
        },
        {
          "type": "collection",
          "id": "cat_3_collection",
          "label": "Category 3 collection"
        },
        {
          "type": "url",
          "id": "cat_3_link",
          "label": "Category 3 custom link (fallback)"
        },
        {
          "type": "text",
          "id": "cat_4_label",
          "label": "Category 4 label"
        },
        {
          "type": "collection",
          "id": "cat_4_collection",
          "label": "Category 4 collection"
        },
        {
          "type": "url",
          "id": "cat_4_link",
          "label": "Category 4 custom link (fallback)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured brands",
      "blocks": [
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}
