Zoiro|zoiro|Hosiery & Innerwear|Men's innerwear & nikar ONLY (Strictly men's)|Men's Innerwear,Men's Nikar,Men's Briefs,All Zoiro Products" | split: '
' -%}

    <div class="mc-brand-dir__groups" data-mc-brand-groups>
      {%- for l in alphabet -%}
        {%- capture group_cards -%}
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- assign b_name = block.settings.name -%}
              {%- if b_name == blank -%}{%- continue -%}{%- endif -%}
              {%- assign first_char = b_name | slice: 0, 1 | upcase -%}
              {%- unless 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' contains first_char -%}
                {%- assign first_char = '#' -%}
              {%- endunless -%}
              {%- if first_char == l -%}
                {%- liquid
                  assign b_handle = block.settings.handle
                  if b_handle == blank
                    assign b_handle = b_name | handleize
                  endif

                  assign b_url = '/pages/brand-' | append: b_handle
                  if block.settings.page != blank
                    assign b_url = block.settings.page.url
                  elsif block.settings.collection != blank
                    assign b_url = block.settings.collection.url
                  elsif block.settings.link != blank
                    assign b_url = block.settings.link
                  endif
                -%}
                <article class="mc-brand-dir-card" data-mc-brand-card data-brand-name="{{ b_name | downcase }}" {{ block.shopify_attributes }}>
                  <div class="mc-brand-dir-card__head">
                    <div>
                      {%- if block.settings.department != blank -%}
                        <span class="mc-brand-dir-card__dept">{{ block.settings.department | escape }}</span>
                      {%- endif -%}
                      <h3 class="mc-brand-dir-card__name">
                        <a href="{{ b_url }}">{{ b_name | escape }}</a>
                      </h3>
                      {%- if block.settings.rule != blank -%}
                        <p class="mc-brand-dir-card__rule">{{ block.settings.rule | escape }}</p>
                      {%- endif -%}
                    </div>
                    {%- if block.settings.image != blank -%}
                      <div class="mc-brand-dir-card__logo">
                        {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', class: 'mc-brand-dir-card__logo-img', alt: b_name | escape }}
                      </div>
                    {%- endif -%}
                  </div>

                  {%- if block.settings.categories != blank -%}
                    {%- assign card_cats = block.settings.categories | split: ',' -%}
                    <div class="mc-brand-dir-card__cats">
                      {%- for c in card_cats -%}
                        <a class="mc-brand-dir-card__cat-pill" href="{{ b_url }}#brand-categories">{{ c | strip | escape }}</a>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  <div class="mc-brand-dir-card__footer">
                    <a class="mc-btn mc-btn--secondary mc-btn--sm" href="{{ b_url }}">
                      Explore Brand
                      <svg class="mc-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for row in canonical_raw -%}
              {%- assign fields = row | split: '|' -%}
              {%- assign b_name = fields[0] -%}
              {%- assign b_handle = fields[1] -%}
              {%- assign b_dept = fields[2] -%}
              {%- assign b_rule = fields[3] -%}
              {%- assign b_cats = fields[4] -%}

              {%- assign first_char = b_name | slice: 0, 1 | upcase -%}
              {%- unless 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' contains first_char -%}
                {%- assign first_char = '#' -%}
              {%- endunless -%}

              {%- if first_char == l -%}
                {%- assign b_url = '/pages/brand-' | append: b_handle -%}
                <article class="mc-brand-dir-card" data-mc-brand-card data-brand-name="{{ b_name | downcase }}">
                  <div class="mc-brand-dir-card__head">
                    <div>
                      <span class="mc-brand-dir-card__dept">{{ b_dept | escape }}</span>
                      <h3 class="mc-brand-dir-card__name">
                        <a href="{{ b_url }}">{{ b_name | escape }}</a>
                      </h3>
                      <p class="mc-brand-dir-card__rule">{{ b_rule | escape }}</p>
                    </div>
                  </div>

                  {%- if b_cats != blank -%}
                    {%- assign card_cats = b_cats | split: ',' -%}
                    <div class="mc-brand-dir-card__cats">
                      {%- for c in card_cats -%}
                        <a class="mc-brand-dir-card__cat-pill" href="{{ b_url }}#brand-categories">{{ c | strip | escape }}</a>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  <div class="mc-brand-dir-card__footer">
                    <a class="mc-btn mc-btn--secondary mc-btn--sm" href="{{ b_url }}">
                      Explore Brand
                      <svg class="mc-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endcapture -%}

        {%- if group_cards != blank -%}
          <div class="mc-brand-dir__group" id="letter-{{ l }}" data-mc-letter-group="{{ l }}">
            <div class="mc-brand-dir__letter-badge">{{ l }}</div>
            <div class="mc-brand-dir__group-cards">
              {{ group_cards }}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="mc-empty-state mc-brand-dir__empty" data-mc-brand-empty hidden>
      <div class="mc-brand-empty__icon" aria-hidden="true">
        <svg class="mc-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </div>
      <h3 class="mc-empty-state__title">No brand matches your search</h3>
      <p class="mc-empty-state__text">We stock 30 authentic brands across beauty, skincare, innerwear, haircare and accessories.</p>
      <button type="button" class="mc-btn mc-btn--primary mc-btn--sm" data-mc-brand-reset>Show All 30 Brands</button>
    </div>
  </div>
</section>

<script>
  (function () {
    'use strict';
    var sectionEl = document.getElementById('brand-directory');
    if (!sectionEl || sectionEl.dataset.mcInit) return;
    sectionEl.dataset.mcInit = '1';

    var searchInput = sectionEl.querySelector('[data-mc-brand-search]');
    var clearBtn = sectionEl.querySelector('[data-mc-brand-clear]');
    var emptyEl = sectionEl.querySelector('[data-mc-brand-empty]');
    var resetBtn = sectionEl.querySelector('[data-mc-brand-reset]');
    var cards = sectionEl.querySelectorAll('[data-mc-brand-card]');
    var groups = sectionEl.querySelectorAll('[data-mc-letter-group]');
    var letterLinks = sectionEl.querySelectorAll('.mc-brand-dir__letter');

    function applyFilter() {
      var q = searchInput.value.trim().toLowerCase();
      if (clearBtn) {
        clearBtn.hidden = !q;
      }

      var totalMatches = 0;

      groups.forEach(function (group) {
        var groupCards = group.querySelectorAll('[data-mc-brand-card]');
        var groupMatches = 0;

        groupCards.forEach(function (card) {
          var name = card.getAttribute('data-brand-name') || '';
          var text = card.textContent.toLowerCase();
          var isMatch = !q || name.indexOf(q) !== -1 || text.indexOf(q) !== -1;

          card.hidden = !isMatch;
          if (isMatch) {
            groupMatches++;
            totalMatches++;
          }
        });

        group.hidden = groupMatches === 0;

        var letter = group.getAttribute('data-mc-letter-group');
        var letterLink = sectionEl.querySelector('.mc-brand-dir__letter[data-letter="' + letter + '"]');
        if (letterLink) {
          if (groupMatches === 0) {
            letterLink.classList.add('is-disabled');
          } else {
            letterLink.classList.remove('is-disabled');
          }
        }
      });

      if (emptyEl) {
        emptyEl.hidden = totalMatches > 0;
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', applyFilter);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        searchInput.value = '';
        searchInput.focus();
        applyFilter();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        searchInput.value = '';
        applyFilter();
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Brand directory A–Z",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated Brand Directory"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All Brands A–Z"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introduction",
      "default": "Discover all 30 authentic brands stocked at Mahadev Cutlery & Gift Articles, Ahmedabad. Tap any brand to explore dedicated category collections and verified genuine inventory."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search 30 brands (e.g. Jockey, Lakmé, Minimalist)..."
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand card",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Brand name",
          "info": "Exact brand name"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Brand handle",
          "info": "e.g. 'jockey' -> /pages/brand-jockey"
        },
        {
          "type": "text",
          "id": "department",
          "label": "Primary department",
          "info": "e.g. 'Hosiery & Innerwear' or 'Beauty & Makeup'"
        },
        {
          "type": "text",
          "id": "rule",
          "label": "Verified taxonomy note",
          "info": "e.g. \"Men's innerwear only\" or \"100% genuine cosmetics\""
        },
        {
          "type": "text",
          "id": "categories",
          "label": "Category pills (comma-separated)",
          "info": "e.g. Men's Innerwear, Women's Innerwear, Socks"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Dedicated brand page (optional)"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Brand collection (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom URL (optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Brand logo / image (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand directory A–Z"
    }
  ]
}
{% endschema %}
