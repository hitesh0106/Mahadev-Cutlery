{%- comment -%}
  Shop by product type — circular image chips.
  Each block has its own title, collection picker, optional custom link,
  optional image, and enable/disable toggle. The merchant can select a
  unique Shopify collection for every single tile independently.

  Link priority:
    1. If a collection is selected → collection.url
    2. If a custom link is provided → custom link
    3. Otherwise → storefront search for the type name
{%- endcomment -%}
{%- liquid
  assign pt_rendered = 0
  for block in section.blocks
    if block.settings.title != blank and block.settings.enabled
      assign pt_rendered = pt_rendered | plus: 1
    endif
  endfor
-%}
  <section class="mc-section mc-section--soft mc-types">
    <div class="mc-container">
      <div class="mc-section__head mc-section__head--center">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="mc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="mc-section__heading mc-section__heading--flush">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
      </div>
      <ul class="mc-types__grid">
        {%- if pt_rendered > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign pt_title = block.settings.title -%}
            {%- if pt_title == blank or block.settings.enabled == false -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign pt_handle = pt_title | handleize
              assign pt_asset = 'dept-beauty.jpg'
              if pt_handle contains 'shampoo' or pt_handle contains 'conditioner'
                assign pt_asset = 'dept-haircare.jpg'
              elsif pt_handle contains 'lip' or pt_handle contains 'makeup' or pt_handle contains 'foundation' or pt_handle contains 'kajal' or pt_handle contains 'mascara'
                assign pt_asset = 'dept-makeup.jpg'
              elsif pt_handle contains 'innerwear'
                assign pt_asset = 'dept-innerwear.jpg'
              elsif pt_handle contains 'gift'
                assign pt_asset = 'dept-gifts.jpg'
              elsif pt_handle contains 'toy' or pt_handle contains 'game'
                assign pt_asset = 'dept-kids.jpg'
              elsif pt_handle contains 'jewellery'
                assign pt_asset = 'dept-jewellery.jpg'
              elsif pt_handle contains 'groom' or pt_handle contains 'styling' or pt_handle contains 'tool'
                assign pt_asset = 'dept-tools.jpg'
              elsif pt_handle contains 'cream' or pt_handle contains 'serum' or pt_handle contains 'moistur' or pt_handle contains 'wash'
                assign pt_asset = 'editorial-skincare.jpg'
              endif

              assign pt_href = ''
              if block.settings.collection != blank
                assign pt_href = block.settings.collection.url
              elsif block.settings.link != blank
                assign pt_href = block.settings.link
              endif
            -%}
            <li {{ block.shopify_attributes }}>
              {%- if pt_href != blank -%}
                <a
                  class="mc-type"
                  href="{{ pt_href }}"
                  aria-label="{{ pt_title | escape }}"
                >
              {%- else -%}
                <span
                  class="mc-type mc-type--static"
                  aria-label="{{ pt_title | escape }}"
                >
              {%- endif -%}
                <span class="mc-type__media">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 264 | image_tag: loading: 'lazy', widths: '132, 264', class: 'mc-type__img', alt: pt_title | escape }}
                  {%- else -%}
                    <img class="mc-type__img" src="{{ pt_asset | asset_url }}" alt="{{ pt_title | escape }}" loading="lazy" width="264" height="264">
                  {%- endif -%}
                </span>
                <span class="mc-type__label">{{ pt_title | escape }}</span>
              {%- if pt_href != blank -%}
                </a>
              {%- else -%}
                </span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Guaranteed canonical product types from Part 2 & Part 3 {%- endcomment -%}
          {%- assign pt_defaults = "Face Wash:dept-beauty.jpg,Moisturizer:editorial-skincare.jpg,Face Serum:dept-beauty.jpg,Shampoo:dept-haircare.jpg,Conditioner:dept-haircare.jpg,Lipstick & Lip Care:dept-makeup.jpg,Foundation & Compact:dept-makeup.jpg,Kajal & Mascara:dept-makeup.jpg,Men's Innerwear:dept-innerwear.jpg,Women's Innerwear:dept-innerwear.jpg,Children's Innerwear:dept-innerwear.jpg,Hair Styling Tools:dept-haircare.jpg,Toys & Games:dept-kids.jpg,Gift Sets:dept-gifts.jpg,Imitation Jewellery:dept-jewellery.jpg,Grooming Tools:dept-tools.jpg" | split: ',' -%}
          {%- for item in pt_defaults -%}
            {%- assign parts = item | split: ':' -%}
            {%- assign pt_name = parts[0] -%}
            {%- assign pt_img = parts[1] -%}
            <li>
              <span class="mc-type mc-type--static" aria-label="{{ pt_name | escape }}">
                <span class="mc-type__media">
                  <img class="mc-type__img" src="{{ pt_img | asset_url }}" alt="{{ pt_name | escape }}" loading="lazy" width="264" height="264">
                </span>
                <span class="mc-type__label">{{ pt_name | escape }}</span>
              </span>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </section>

{% schema %}
{
  "name": "Product types",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find it fast"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by product type"
    }
  ],
  "blocks": [
    {
      "type": "type",
      "name": "Product type",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this tile",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "Type title",
          "info": "e.g. Face Wash, Serum, Shampoo, Innerwear, Gifts, Toys"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Select the Shopify collection this tile should link to. Each tile can have its own independent collection."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (fallback)",
          "info": "Used only when no collection is selected above. If both are empty, defaults to a storefront search."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional)",
          "info": "Circular thumbnail for this tile. Uses a category placeholder when empty."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product types",
      "blocks": [
        { "type": "type", "settings": { "title": "Face Wash" } },
        { "type": "type", "settings": { "title": "Moisturizer" } },
        { "type": "type", "settings": { "title": "Face Serum" } },
        { "type": "type", "settings": { "title": "Shampoo" } },
        { "type": "type", "settings": { "title": "Conditioner" } },
        { "type": "type", "settings": { "title": "Lipstick & Lip Care" } },
        { "type": "type", "settings": { "title": "Foundation & Compact" } },
        { "type": "type", "settings": { "title": "Kajal & Mascara" } },
        { "type": "type", "settings": { "title": "Men's Innerwear" } },
        { "type": "type", "settings": { "title": "Women's Innerwear" } },
        { "type": "type", "settings": { "title": "Children's Innerwear" } },
        { "type": "type", "settings": { "title": "Hair Styling Tools" } },
        { "type": "type", "settings": { "title": "Toys & Games" } },
        { "type": "type", "settings": { "title": "Gift Sets" } },
        { "type": "type", "settings": { "title": "Imitation Jewellery" } },
        { "type": "type", "settings": { "title": "Grooming Tools" } }
      ]
    }
  ]
}
{% endschema %}
