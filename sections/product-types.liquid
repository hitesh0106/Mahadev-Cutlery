{%- comment -%}
  Shop by product type — circular image chips.
  Supports BOTH:
  1. OS 2.0 Blocks with native drag-and-drop ordering:
     Each block has its own:
     - Title
     - Circular image upload
     - Independent Shopify collection selector (type: collection)
     - Optional custom URL
     - Enable/disable toggle
     - Image alt text
  2. Fallback section-level independent collection pickers (collection_1 to collection_16)
     so the merchant can also configure collections directly in the right-side section settings.

  Click behavior:
  - If a collection is selected, links automatically to collection.url.
  - If a custom link is provided, links to custom URL.
  - If neither is assigned, renders a clean, static, accessible chip (no broken links).
{%- endcomment -%}
{%- liquid
  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif
-%}

<section class="mc-section mc-section--soft mc-types" id="product-types" data-testid="product-types-section">
  <div class="mc-container">
    <div class="mc-section__head mc-section__head--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="mc-eyebrow">— {{ section.settings.eyebrow | escape | upcase }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="mc-section__heading mc-section__heading--flush">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    </div>

    <ul class="mc-types__grid">
      {%- if has_blocks -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.enabled == false -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign pt_title = block.settings.title
            if pt_title == blank and block.settings.collection != blank
              assign pt_title = block.settings.collection.title
            endif
            if pt_title == blank
              assign pt_title = 'Product Type'
            endif

            assign pt_handle = pt_title | handleize
            assign pt_asset = 'dept-beauty.jpg'
            if pt_handle contains 'shampoo' or pt_handle contains 'conditioner'
              assign pt_asset = 'dept-haircare.jpg'
            elsif pt_handle contains 'lip' or pt_handle contains 'makeup' or pt_handle contains 'foundation' or pt_handle contains 'kajal' or pt_handle contains 'mascara'
              assign pt_asset = 'dept-makeup.jpg'
            elsif pt_handle contains 'innerwear'
              assign pt_asset = 'dept-innerwear.jpg'
            elsif pt_handle contains 'gift'
              assign pt_asset = 'dept-gifts.jpg'
            elsif pt_handle contains 'toy' or pt_handle contains 'game'
              assign pt_asset = 'dept-kids.jpg'
            elsif pt_handle contains 'jewellery'
              assign pt_asset = 'dept-jewellery.jpg'
            elsif pt_handle contains 'groom' or pt_handle contains 'styling' or pt_handle contains 'tool'
              assign pt_asset = 'dept-tools.jpg'
            elsif pt_handle contains 'cream' or pt_handle contains 'serum' or pt_handle contains 'moistur' or pt_handle contains 'wash'
              assign pt_asset = 'editorial-skincare.jpg'
            endif

            assign col_fallback_key = 'collection_' | append: forloop.index
            assign sec_col = section.settings[col_fallback_key]

            assign pt_href = ''
            if block.settings.collection != blank
              assign pt_href = block.settings.collection.url
            elsif sec_col != blank
              assign pt_href = sec_col.url
            elsif block.settings.link != blank
              assign pt_href = block.settings.link
            endif

            assign pt_alt = block.settings.alt_text
            if pt_alt == blank
              if block.settings.image != blank and block.settings.image.alt != blank
                assign pt_alt = block.settings.image.alt
              else
                assign pt_alt = pt_title
              endif
            endif
          -%}
          <li {{ block.shopify_attributes }}>
            {%- if pt_href != blank -%}
              <a class="mc-type" href="{{ pt_href }}" aria-label="{{ pt_title | escape }}">
            {%- else -%}
              <span class="mc-type mc-type--static" aria-label="{{ pt_title | escape }}">
            {%- endif -%}
              <span class="mc-type__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 264 | image_tag: loading: 'lazy', widths: '132, 264', class: 'mc-type__img', alt: pt_alt | escape }}
                {%- elsif block.settings.collection != blank and block.settings.collection.image != blank -%}
                  {{ block.settings.collection.image | image_url: width: 264 | image_tag: loading: 'lazy', widths: '132, 264', class: 'mc-type__img', alt: pt_alt | escape }}
                {%- elsif sec_col != blank and sec_col.image != blank -%}
                  {{ sec_col.image | image_url: width: 264 | image_tag: loading: 'lazy', widths: '132, 264', class: 'mc-type__img', alt: pt_alt | escape }}
                {%- else -%}
                  <img class="mc-type__img" src="{{ pt_asset | asset_url }}" alt="{{ pt_alt | escape }}" loading="lazy" width="264" height="264">
                {%- endif -%}
              </span>
              <span class="mc-type__label">{{ pt_title | escape }}</span>
            {%- if pt_href != blank -%}
              </a>
            {%- else -%}
              </span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Guaranteed canonical 16 product types {%- endcomment -%}
        {%- assign pt_defaults = "Face Wash:editorial-skincare.jpg,Moisturizer:editorial-skincare.jpg,Face Serum:dept-beauty.jpg,Shampoo:dept-haircare.jpg,Conditioner:dept-haircare.jpg,Lipstick & Lip Care:dept-makeup.jpg,Foundation & Compact:dept-makeup.jpg,Kajal & Mascara:dept-makeup.jpg,Men's Innerwear:dept-innerwear.jpg,Women's Innerwear:dept-innerwear.jpg,Children's Innerwear:dept-kids.jpg,Hair Styling Tools:dept-tools.jpg,Toys & Games:dept-kids.jpg,Gift Sets:dept-gifts.jpg,Imitation Jewellery:dept-jewellery.jpg,Grooming Tools:dept-tools.jpg" | split: ',' -%}
        {%- for item in pt_defaults -%}
          {%- assign parts = item | split: ':' -%}
          {%- assign pt_name = parts[0] -%}
          {%- assign pt_img = parts[1] -%}
          {%- assign col_key = 'collection_' | append: forloop.index -%}
          {%- assign pt_col = section.settings[col_key] -%}
          {%- assign pt_href = '' -%}
          {%- if pt_col != blank -%}
            {%- assign pt_href = pt_col.url -%}
          {%- endif -%}
          <li>
            {%- if pt_href != blank -%}
              <a class="mc-type" href="{{ pt_href }}" aria-label="{{ pt_name | escape }}">
            {%- else -%}
              <span class="mc-type mc-type--static" aria-label="{{ pt_name | escape }}">
            {%- endif -%}
              <span class="mc-type__media">
                {%- if pt_col != blank and pt_col.image != blank -%}
                  {{ pt_col.image | image_url: width: 264 | image_tag: loading: 'lazy', widths: '132, 264', class: 'mc-type__img', alt: pt_name | escape }}
                {%- else -%}
                  <img class="mc-type__img" src="{{ pt_img | asset_url }}" alt="{{ pt_name | escape }}" loading="lazy" width="264" height="264">
                {%- endif -%}
              </span>
              <span class="mc-type__label">{{ pt_name | escape }}</span>
            {%- if pt_href != blank -%}
              </a>
            {%- else -%}
              </span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

