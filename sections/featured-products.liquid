{%- comment -%}
  Featured products — grid / carousel of product cards from a picked collection.
  Falls back to guaranteed canonical sample products when none is picked or collection is empty.
  Matches reference design (Image 2 parity).
{%- endcomment -%}
{%- liquid
  assign fp_collection = section.settings.collection
  if fp_collection == blank
    assign fp_collection = collections.all
  endif

  assign has_real_products = false
  if fp_collection != blank and fp_collection.products.size > 0
    assign has_real_products = true
  endif

  assign fp_limit = section.settings.products_to_show | default: 4

  assign is_new_arrivals = false
  assign h_lower = section.settings.heading | downcase
  assign e_lower = section.settings.eyebrow | downcase
  if h_lower contains 'new' or h_lower contains 'arrivals' or e_lower contains 'just'
    assign is_new_arrivals = true
  endif
-%}

<section class="mc-section{% if section.settings.bg_soft %} mc-section--soft{% endif %} mc-featured-products" id="{{ section.settings.heading | handleize | default: 'featured-products' }}" data-testid="featured-products-section">
  <div class="mc-container">
    <div class="mc-section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="mc-eyebrow">— {{ section.settings.eyebrow | escape | upcase }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="mc-section__heading mc-section__heading--flush">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all -%}
        <a class="mc-action-link" href="{{ fp_collection.url | default: routes.all_products_collection_url }}">
          VIEW ALL
          <svg class="mc-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>

    <ul class="mc-products-carousel" data-carousel-track>
      {%- if has_real_products -%}
        {%- for product in fp_collection.products limit: fp_limit -%}
          <li class="mc-products-carousel__item">
            {% render 'product-card', card_product: product, show_vendor: true, reveal: false %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..fp_limit) -%}
          <li class="mc-products-carousel__item">
            <article class="mc-card mc-card--placeholder">
              <div class="mc-card__media-wrap">
                <div class="mc-card__placeholder-media" style="aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;background:var(--mc-cream,#FBF9F5);color:var(--mc-muted,#8C827A);">
                  {{ 'product-' | append: i | placeholder_svg_tag: 'mc-card__placeholder-svg' }}
                </div>
              </div>
              <div class="mc-card__body">
                <p class="mc-card__vendor">{{ shop.name | default: 'MAHADEV' }}</p>
                <h3 class="mc-card__title">
                  <a href="{{ fp_collection.url | default: routes.all_products_collection_url }}">{{ 'cart.product' | t | default: 'Curated Item' }}</a>
                </h3>
                <div class="mc-card__price">
                  <span class="mc-price">—</span>
                </div>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    <div class="mc-carousel-nav" aria-label="Carousel navigation">
      <button type="button" class="mc-carousel-btn mc-carousel-btn--prev" aria-label="Previous products" data-carousel-prev>
        <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button type="button" class="mc-carousel-btn mc-carousel-btn--next" aria-label="Next products" data-carousel-next>
        <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (optional)",
      "default": "Trending now"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending products"
    },
    {
      "type": "checkbox",
      "id": "bg_soft",
      "label": "Warm background",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to use All Products or fallback sample cards."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 2,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show “VIEW ALL” link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
