            <article class="mc-card">
              <div class="mc-card__media-wrap">
                <a class="mc-card__media" href="{{ routes.collections_url }}/hosiery-innerwear" aria-label="Men's cotton brief, pack of 2">
                  <img class="mc-card__img" src="{{ 'dept-innerwear.jpg' | asset_url }}" alt="Men's cotton brief, pack of 2" width="600" height="600" loading="eager">
                </a>
                <div class="mc-card__wishlist">
                  <button type="button" class="mc-wl-btn" data-mc-wishlist aria-label="Save to wishlist" onclick="this.classList.toggle('is-active')">
                    <span class="mc-wl-btn__icons" aria-hidden="true">
                      {% render 'icon', name: 'heart', class: 'mc-wl-btn__outline' %}
                      {% render 'icon', name: 'heart-filled', class: 'mc-wl-btn__filled' %}
                    </span>
                  </button>
                </div>
              </div>
              <div class="mc-card__body">
                <p class="mc-card__vendor">SAMPLE BRAND</p>
                <h3 class="mc-card__title">
                  <a href="{{ routes.collections_url }}/hosiery-innerwear">Men's cotton brief, pack of 2</a>
                </h3>
                <div class="mc-card__price">
                  <span class="mc-price">₹399</span>
                </div>
              </div>
            </article>
          </li>
          <li class="mc-products-carousel__item">
            <article class="mc-card">
