{%- comment -%}
  Featured products — grid / carousel of product cards from a picked collection.
  Falls back to guaranteed canonical sample products when none is picked or collection is empty.
  Matches reference design (Image 2 parity).
{%- endcomment -%}
{%- liquid
  assign fp_collection = section.settings.collection
  if fp_collection == blank
    assign fp_collection = collections.all
  endif

  assign has_real_products = false
  if fp_collection != blank and fp_collection.products.size > 0
    assign has_real_products = true
  endif

  assign fp_limit = section.settings.products_to_show | default: 4

  assign is_new_arrivals = false
  assign h_lower = section.settings.heading | downcase
  assign e_lower = section.settings.eyebrow | downcase
  if h_lower contains 'new' or h_lower contains 'arrivals' or e_lower contains 'just'
    assign is_new_arrivals = true
  endif
-%}

<section class="mc-section{% if section.settings.bg_soft %} mc-section--soft{% endif %} mc-featured-products" id="{{ section.settings.heading | handleize | default: 'featured-products' }}" data-testid="featured-products-section">
  <div class="mc-container">
    <div class="mc-section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="mc-eyebrow">— {{ section.settings.eyebrow | escape | upcase }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="mc-section__heading mc-section__heading--flush">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all -%}
        <a class="mc-action-link" href="{{ fp_collection.url | default: routes.all_products_collection_url }}">
          VIEW ALL
          <svg class="mc-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>

    <ul class="mc-products-carousel" data-carousel-track>
      {%- if has_real_products -%}
        {%- for product in fp_collection.products limit: fp_limit -%}
          <li class="mc-products-carousel__item">
            {% render 'product-card', card_product: product, show_vendor: true, reveal: false %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- if is_new_arrivals -%}
          {%- comment -%} Sample Products Set 2 (New arrivals) {%- endcomment -%}
