{%- comment -%}
  Featured products — carousel of product cards from a picked collection or explicit product list.
  Uses real Shopify product data only. If the selected collection is empty,
  it never generates fabricated products on the live storefront.
{%- endcomment -%}
{%- liquid
  assign fp_products = nil
  assign has_real_products = false
  assign fp_url = routes.all_products_collection_url

  if section.settings.product_list != blank and section.settings.product_list.count > 0
    assign fp_products = section.settings.product_list
    assign has_real_products = true
  elsif section.settings.collection != blank and section.settings.collection.products_count > 0
    assign fp_products = section.settings.collection.products
    assign has_real_products = true
    assign fp_url = section.settings.collection.url
  elsif section.settings.collection == blank and collections.all != blank and collections.all.products_count > 0
    assign fp_products = collections.all.products
    assign has_real_products = true
    assign fp_url = collections.all.url
  endif

  assign fp_limit = section.settings.products_to_show | default: 8
-%}

<section class="mc-section{% if section.settings.bg_soft %} mc-section--soft{% endif %} mc-featured-products" id="{{ section.settings.heading | handleize | default: 'featured-products' }}" data-testid="featured-products-section">
  <div class="mc-container">
    <div class="mc-section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="mc-eyebrow">— {{ section.settings.eyebrow | escape | upcase }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="mc-section__heading mc-section__heading--flush">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all and has_real_products -%}
        <a class="mc-action-link" href="{{ fp_url }}">
          VIEW ALL
          <svg class="mc-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>

    <ul class="mc-products-carousel" data-carousel-track>
      {%- if has_real_products -%}
        {%- for product in fp_products limit: fp_limit -%}
          <li class="mc-products-carousel__item">
            {% render 'product-card', card_product: product, show_vendor: true, reveal: false %}
          </li>
        {%- endfor -%}
      {%- elsif request.design_mode -%}
        {%- for i in (1..fp_limit) -%}
          <li class="mc-products-carousel__item">
            <article class="mc-card mc-card--placeholder">
              <div class="mc-card__media-wrap">
                <div class="mc-card__placeholder-media" style="aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;background:var(--mc-cream,#FBF9F5);color:var(--mc-muted,#8C827A);">
                  {{ 'product-' | append: i | placeholder_svg_tag: 'mc-card__placeholder-svg' }}
                </div>
              </div>
              <div class="mc-card__body">
                <p class="mc-card__vendor">Theme Editor Preview</p>
                <h3 class="mc-card__title">
                  <span>Assign a collection or product list</span>
                </h3>
                <div class="mc-card__price">
                  <span class="mc-price">—</span>
                </div>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- else -%}
        <li class="mc-products-carousel__empty" style="grid-column: 1 / -1; padding: 48px 16px; text-align: center; color: var(--mc-ink-soft); list-style: none; width: 100%;">
          <p style="margin: 0 0 12px; font-size: 15px;">{{ 'collections.empty' | t | default: 'No products currently available in this section.' }}</p>
          <a class="mc-btn mc-btn--secondary mc-btn--sm" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty_cta' | t | default: 'Explore All Products' }}</a>
        </li>
      {%- endif -%}
    </ul>

    {%- if has_real_products -%}
      <div class="mc-carousel-nav" aria-label="Carousel navigation">
        <button type="button" class="mc-carousel-btn mc-carousel-btn--prev" aria-label="Previous products" data-carousel-prev>
          <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" class="mc-carousel-btn mc-carousel-btn--next" aria-label="Next products" data-carousel-next>
          <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (optional)",
      "default": "Trending now"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending products"
    },
    {
      "type": "checkbox",
      "id": "bg_soft",
      "label": "Warm background",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify collection",
      "info": "Select the independent Shopify collection for this section."
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Or select specific products (optional)",
      "info": "Explicitly select specific products. Takes priority over collection when set."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 2,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show “VIEW ALL” link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
