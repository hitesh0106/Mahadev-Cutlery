{%- comment -%}
  Site header — Editorial 2-row luxury brand header.
  - Row 0: Slim editable announcement bar (centered, optional rotator)
  - Row 1: Main Brand Row (Grid 1fr auto 1fr: Left: Search & Mobile Burger | Center: Visually Centered MAHADEV Wordmark | Right: Account, Wishlist, Cart)
  - Row 2: Navigation Row (Centred desktop navigation with approved 8 departments, mega-menus & responsive "More" dropdown)
  - Mobile: Drawer navigation panel with department accordions, search, and accounts
{%- endcomment -%}
{%- assign hh_main = section.settings.main_menu -%}
{%- assign hh_departments = section.settings.departments_menu -%}
{%- assign hh_brands = section.settings.brands_menu -%}
{%- assign hh_logo_text = settings.logo_text -%}
{%- if hh_logo_text == blank -%}{%- assign hh_logo_text = shop.name -%}{%- endif -%}

<header
  class="mc-header"
  data-mc-header
  data-mc-sticky="{{ section.settings.sticky_header | default: true }}"
>
  {%- if section.settings.show_announcement and section.settings.announcement_text != blank -%}
    <aside
      class="mc-announcement"
      style="background-color: {{ section.settings.announcement_bg | default: '#20201E' }}; color: {{ section.settings.announcement_text_color | default: '#FAF8F5' }};"
      data-mc-ann
      aria-label="{{ 'announcement.note' | t | default: 'Announcement' }}"
    >
      <div class="mc-announcement__inner mc-container">
        {%- if section.settings.announcement_text_2 != blank -%}
          <button type="button" class="mc-announcement__arrow mc-announcement__arrow--prev" data-mc-ann-prev aria-label="{{ 'general.previous' | t }}">
            <svg class="mc-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg>
          </button>
        {%- endif -%}

        <div class="mc-announcement__stack" aria-live="polite">
          <div class="mc-announcement__slide is-active" data-mc-ann-slide>
            {%- if section.settings.announcement_link != blank -%}
              <a class="mc-announcement__link" href="{{ section.settings.announcement_link }}">
                {{ section.settings.announcement_text | escape }}
              </a>
            {%- else -%}
              <span class="mc-announcement__text">{{ section.settings.announcement_text | escape }}</span>
            {%- endif -%}
          </div>

          {%- if section.settings.announcement_text_2 != blank -%}
            <div class="mc-announcement__slide" data-mc-ann-slide>
              {%- if section.settings.announcement_link_2 != blank -%}
                <a class="mc-announcement__link" href="{{ section.settings.announcement_link_2 }}">
                  {{ section.settings.announcement_text_2 | escape }}
                </a>
              {%- else -%}
                <span class="mc-announcement__text">{{ section.settings.announcement_text_2 | escape }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.announcement_text_2 != blank -%}
          <button type="button" class="mc-announcement__arrow mc-announcement__arrow--next" data-mc-ann-next aria-label="{{ 'general.next' | t }}">
            <svg class="mc-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        {%- endif -%}
      </div>
    </aside>
  {%- endif -%}

  {%- comment -%} Main Brand Row: Search on Left | Wordmark in Exact Center | Account, Wishlist, Cart on Right {%- endcomment -%}
  <div class="mc-header__brand-row mc-container">
    <div class="mc-header__col mc-header__col--left">
      <button
        type="button"
        class="mc-icon-btn mc-header__burger"
        data-mc-nav-open
        aria-controls="mc-nav-drawer"
        aria-expanded="false"
        aria-label="{{ 'general.menu' | t }}"
      >
        {% render 'icon', name: 'menu' %}
      </button>

      {%- if section.settings.show_search -%}
        <button
          type="button"
          class="mc-icon-btn mc-header__search-toggle"
          data-mc-search-toggle
          aria-controls="mc-header-search"
          aria-expanded="false"
          aria-label="{{ 'header.search' | t }}"
        >
          {% render 'icon', name: 'search' %}
        </button>
      {%- endif -%}
    </div>

    <div class="mc-header__col mc-header__col--center">
      <a class="mc-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- assign logo_img = section.settings.logo | default: settings.logo -%}
        {%- if logo_img != blank -%}
          {%- assign logo_w = section.settings.logo_width | default: settings.logo_width | default: 180 -%}
          <img
            class="mc-logo__img"
            src="{{ logo_img | image_url: width: logo_w }}"
            alt="{{ shop.name | escape }}"
            width="{{ logo_w }}"
            height="{{ logo_w | divided_by: logo_img.aspect_ratio | round }}"
            loading="eager"
          >
        {%- else -%}
          <span class="mc-logo__text">
            <span class="mc-logo__diamond" aria-hidden="true">◇</span>
            {{ hh_logo_text | escape }}
          </span>
          <span class="mc-logo__subline">{{ section.settings.logo_subline | default: settings.logo_subline | default: 'CUTLERY & GIFT ARTICLES' | escape }}</span>
        {%- endif -%}
      </a>
    </div>

    <div class="mc-header__col mc-header__col--right">
      <a class="mc-icon-btn mc-header__account" href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url | default: '/account/login' }}{%- endif -%}" aria-label="{{ 'header.account' | t }}">
        {% render 'icon', name: 'user' %}
      </a>

      {%- if settings.enable_wishlist != false -%}
        <a class="mc-icon-btn mc-header__wishlist" href="{{ section.settings.wishlist_url | default: '/pages/wishlist' }}" aria-label="{{ 'header.wishlist' | t }}">
          {% render 'icon', name: 'heart' %}
          <span class="mc-count-bubble" data-mc-wishlist-count-bubble style="display:none">0</span>
        </a>
      {%- endif -%}

      {%- if settings.cart_type == 'page' -%}
        <a class="mc-icon-btn mc-header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t }}">
          {% render 'icon', name: 'cart' %}
          <span class="mc-count-bubble" data-mc-cart-count-bubble>{{ cart.item_count }}</span>
        </a>
      {%- else -%}
        <button type="button" class="mc-icon-btn mc-header__cart" data-mc-cart-open aria-label="{{ 'header.cart' | t }}">
          {% render 'icon', name: 'cart' %}
          <span class="mc-count-bubble" data-mc-cart-count-bubble>{{ cart.item_count }}</span>
        </button>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Navigation Row: Dedicated, Centered Navigation Menu {%- endcomment -%}
  {%- liquid
    assign has_main_menu = false
    if hh_main != blank and hh_main.links.size > 0
      assign has_main_menu = true
    endif

    assign main_has_departments = false
    assign main_has_brands = false
    if has_main_menu
      for link in hh_main.links
        assign l_title_lower = link.title | downcase
        if l_title_lower contains 'department'
          assign main_has_departments = true
        endif
        if l_title_lower contains 'brand'
          assign main_has_brands = true
        endif
      endfor
    endif
  -%}

  <div class="mc-header__nav-row">
    <nav class="mc-nav mc-container" aria-label="{{ 'general.menu' | t }}">
      <ul class="mc-nav__list" data-mc-nav-list>
        {%- if has_main_menu -%}
          {%- for link in hh_main.links -%}
            {%- assign l_title_lower = link.title | downcase -%}
            {%- if l_title_lower == 'home' or l_title_lower == 'contact' or l_title_lower == 'contact us' -%}
              {%- continue -%}
            {%- endif -%}
            {%- if l_title_lower contains 'department' -%}
              <li class="mc-nav__item mc-nav__item--mega" data-mc-mega>
                <button
                  type="button"
                  class="mc-nav__link mc-nav__toggle"
                  data-mc-menu-toggle
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  {{ link.title | escape }}
                  {% render 'icon', name: 'chevron', size: 11, class: 'mc-nav__chevron' %}
                </button>
                <div class="mc-mega">
                  <div class="mc-mega__inner">
                    <p class="mc-mega__heading">{{ 'header.departments' | t | default: 'Shop by Department' }}</p>
                    <ul class="mc-mega__list mc-mega__list--cols">
                      {%- if hh_departments != blank and hh_departments.links.size > 0 -%}
                        {%- for dlink in hh_departments.links -%}
                          <li><a class="mc-mega__link" href="{{ dlink.url }}">{{ dlink.title | escape }}</a></li>
                        {%- endfor -%}
                      {%- else -%}
                        <li><a class="mc-mega__link" href="{{ routes.collections_url }}/beauty-makeup">Beauty &amp; Makeup</a></li>
                        <li><a class="mc-mega__link" href="{{ routes.collections_url }}/skincare">Skincare</a></li>
                        <li><a class="mc-mega__link" href="{{ routes.collections_url }}/haircare">Haircare</a></li>
                        <li><a class="mc-mega__link" href="{{ routes.collections_url }}/hosiery-innerwear">Hosiery &amp; Innerwear</a></li>
                        <li><a class="mc-mega__link" href="{{ routes.collections_url }}/toys-kids">Toys &amp; Kids</a></li>
                        <li><a class="mc-mega__link" href="{{ routes.collections_url }}/gift-articles">Gift Articles</a></li>
                        <li><a class="mc-mega__link" href="{{ routes.collections_url }}/imitation-jewellery">Imitation Jewellery</a></li>
                        <li><a class="mc-mega__link" href="{{ routes.collections_url }}/accessories-grooming">Accessories &amp; Grooming</a></li>
                      {%- endif -%}
                    </ul>
                  </div>
                </div>
              </li>
            {%- elsif l_title_lower contains 'brand' -%}
              <li class="mc-nav__item mc-nav__item--mega" data-mc-mega>
                <button
                  type="button"
                  class="mc-nav__link mc-nav__toggle"
                  data-mc-menu-toggle
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  {{ link.title | escape }}
                  {% render 'icon', name: 'chevron', size: 11, class: 'mc-nav__chevron' %}
                </button>
                <div class="mc-mega">
                  <div class="mc-mega__inner">
                    <p class="mc-mega__heading">{{ 'header.brands' | t | default: 'Shop by Brand' }}</p>
                    <ul class="mc-mega__list mc-mega__list--cols">
                      {%- if hh_brands != blank and hh_brands.links.size > 0 -%}
                        {%- for blink in hh_brands.links -%}
                          <li><a class="mc-mega__link" href="{{ blink.url }}">{{ blink.title | escape }}</a></li>
                        {%- endfor -%}
                      {%- else -%}
                        {%- assign nav_brands = "Jockey:jockey,Van Heusen:van-heusen,Zoiro:zoiro,Bodycare:bodycare,Lady Care:lady-care,Swiss Beauty:swiss-beauty,Lakmé:lakme,Maybelline New York:maybelline-new-york,Faces Canada:faces-canada,Colorbar:colorbar,MARS Cosmetics:mars-cosmetics,Minimalist:minimalist,Dot & Key:dot-key,Cetaphil:cetaphil,Sebamed:sebamed,POND'S:ponds,NIVEA:nivea,Garnier:garnier,Pilgrim:pilgrim,Plix:plix,Lotus Herbals:lotus-herbals,L'Oréal Paris:loreal-paris,L'Oréal Professionnel:loreal-professionnel,Matrix:matrix,Wella Professionals:wella-professionals,VEGA:vega,Philips:philips,Sunny:sunny,Ghar Soaps:ghar-soaps" | split: ',' -%}
                        {%- for item in nav_brands -%}
                          {%- assign b_parts = item | split: ':' -%}
                          <li><a class="mc-mega__link" href="{{ routes.collections_url }}/{{ b_parts[1] }}">{{ b_parts[0] }}</a></li>
                        {%- endfor -%}
                      {%- endif -%}
                    </ul>
                  </div>
                </div>
              </li>
            {%- elsif link.links.size > 0 -%}
              <li class="mc-nav__item mc-nav__item--dropdown">
                <a class="mc-nav__link" href="{{ link.url }}">
                  {{ link.title | escape }}
                  {% render 'icon', name: 'chevron', size: 11, class: 'mc-nav__chevron' %}
                </a>
                <ul class="mc-dropdown">
                  {%- for child in link.links -%}
                    <li><a class="mc-dropdown__link" href="{{ child.url }}">{{ child.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </li>
            {%- else -%}
              <li class="mc-nav__item"><a class="mc-nav__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Default Editorial Navigation: Approved 8 Shopping Departments with Responsive Tiers {%- endcomment -%}
          <li class="mc-nav__item"><a class="mc-nav__link" href="{{ routes.collections_url }}/beauty-makeup">Beauty &amp; Makeup</a></li>
          <li class="mc-nav__item"><a class="mc-nav__link" href="{{ routes.collections_url }}/skincare">Skincare</a></li>
          <li class="mc-nav__item"><a class="mc-nav__link" href="{{ routes.collections_url }}/haircare">Haircare</a></li>
          <li class="mc-nav__item"><a class="mc-nav__link" href="{{ routes.collections_url }}/hosiery-innerwear">Hosiery &amp; Innerwear</a></li>
          <li class="mc-nav__item"><a class="mc-nav__link" href="{{ routes.collections_url }}/toys-kids">Toys &amp; Kids</a></li>
          <li class="mc-nav__item"><a class="mc-nav__link" href="{{ routes.collections_url }}/gift-articles">Gift Articles</a></li>
          <li class="mc-nav__item"><a class="mc-nav__link" href="{{ routes.collections_url }}/imitation-jewellery">Imitation Jewellery</a></li>
          <li class="mc-nav__item mc-nav__item--tier-wide"><a class="mc-nav__link" href="{{ routes.collections_url }}/accessories-grooming">Accessories &amp; Grooming</a></li>
          <li class="mc-nav__item mc-nav__item--tier-wide"><a class="mc-nav__link" href="/pages/brands">{{ 'header.brands' | t | default: 'All Brands' }}</a></li>
          <li class="mc-nav__item mc-nav__item--mega mc-nav__item--tier-wide" data-mc-mega>
            <button
              type="button"
              class="mc-nav__link mc-nav__toggle"
              data-mc-menu-toggle
              aria-expanded="false"
              aria-haspopup="true"
            >
              {{ 'header.departments' | t | default: 'Departments' }} {% render 'icon', name: 'chevron', size: 11, class: 'mc-nav__chevron' %}
            </button>
            <div class="mc-mega">
              <div class="mc-mega__inner">
                <p class="mc-mega__heading">{{ 'header.departments' | t | default: 'Shop by Department' }}</p>
                <ul class="mc-mega__list mc-mega__list--cols">
                  <li><a class="mc-mega__link" href="{{ routes.collections_url }}/beauty-makeup">Beauty &amp; Makeup</a></li>
                  <li><a class="mc-mega__link" href="{{ routes.collections_url }}/skincare">Skincare</a></li>
                  <li><a class="mc-mega__link" href="{{ routes.collections_url }}/haircare">Haircare</a></li>
                  <li><a class="mc-mega__link" href="{{ routes.collections_url }}/hosiery-innerwear">Hosiery &amp; Innerwear</a></li>
                  <li><a class="mc-mega__link" href="{{ routes.collections_url }}/toys-kids">Toys &amp; Kids</a></li>
                  <li><a class="mc-mega__link" href="{{ routes.collections_url }}/gift-articles">Gift Articles</a></li>
                  <li><a class="mc-mega__link" href="{{ routes.collections_url }}/imitation-jewellery">Imitation Jewellery</a></li>
                  <li><a class="mc-mega__link" href="{{ routes.collections_url }}/accessories-grooming">Accessories &amp; Grooming</a></li>
                </ul>
              </div>
            </div>
          </li>
        {%- endif -%}

        {%- comment -%} Intelligent "More ▾" Dropdown Menu for Laptop Widths & Overflow Items {%- endcomment -%}
        <li class="mc-nav__item mc-nav__item--dropdown mc-nav__item--more" data-mc-nav-more>
          <button
            type="button"
            class="mc-nav__link mc-nav__toggle"
            data-mc-menu-toggle
            aria-expanded="false"
            aria-haspopup="true"
          >
            {{ 'header.more' | t | default: 'More' }} {% render 'icon', name: 'chevron', size: 11, class: 'mc-nav__chevron' %}
          </button>
          <ul class="mc-dropdown mc-dropdown--more" data-mc-more-list>
            <li class="mc-more-item--adaptive"><a class="mc-dropdown__link" href="{{ routes.collections_url }}/accessories-grooming">Accessories &amp; Grooming</a></li>
            <li class="mc-more-item--adaptive"><a class="mc-dropdown__link" href="/pages/brands">{{ 'header.brands' | t | default: 'All Brands' }}</a></li>
            <li class="mc-more-item--adaptive"><a class="mc-dropdown__link" href="{{ routes.collections_url }}">{{ 'header.departments' | t | default: 'All Departments' }}</a></li>
            {%- if section.settings.offers_link != blank -%}
              <li><a class="mc-dropdown__link" href="{{ section.settings.offers_link }}">{{ 'header.offers' | t | default: 'Offers' }}</a></li>
            {%- endif -%}
          </ul>
        </li>
      </ul>
    </nav>
  </div>

  {%- if section.settings.show_search -%}
    <div class="mc-header__search" id="mc-header-search" data-mc-search hidden>
      <form class="mc-search-form mc-container" action="{{ routes.search_url }}" method="get" role="search">
        <input
          type="search"
          class="mc-input"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search_placeholder' | t }}"
          aria-label="{{ 'general.search' | t }}"
          data-mc-search-input
        >
        <button type="submit" class="mc-btn mc-btn--primary">{{ 'general.search' | t }}</button>
      </form>
    </div>
  {%- endif -%}
</header>

{%- comment -%} Mobile navigation drawer {%- endcomment -%}
<div id="mc-nav-drawer" class="mc-drawer mc-nav-drawer" data-mc-nav-drawer role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}" hidden>
  <div class="mc-drawer__overlay" data-mc-nav-close></div>
  <aside class="mc-drawer__panel mc-nav-drawer__panel" data-mc-drawer-panel>
    <header class="mc-nav-drawer__head">
      <span class="mc-logo__text">{{ hh_logo_text | escape }}</span>
      <button type="button" class="mc-icon-btn" data-mc-nav-close aria-label="{{ 'general.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </header>
    <nav class="mc-nav-drawer__body" data-mc-drawer-scroll aria-label="{{ 'general.menu' | t }}">
      {%- if has_main_menu -%}
        {%- for link in hh_main.links -%}
          {%- assign l_title_lower = link.title | downcase -%}
          {%- if l_title_lower == 'home' or l_title_lower == 'contact' or l_title_lower == 'contact us' -%}
            {%- continue -%}
          {%- endif -%}
          {%- if l_title_lower contains 'department' -%}
            <details class="mc-nav-drawer__group">
              <summary class="mc-nav-drawer__link">{{ link.title | escape }} {% render 'icon', name: 'chevron', size: 14, class: 'mc-nav__chevron' %}</summary>
              <ul>
                {%- if hh_departments != blank and hh_departments.links.size > 0 -%}
                  {%- for dlink in hh_departments.links -%}
                    <li><a class="mc-nav-drawer__sublink" href="{{ dlink.url }}">{{ dlink.title | escape }}</a></li>
                  {%- endfor -%}
                {%- else -%}
                  <li><a class="mc-nav-drawer__sublink" href="{{ routes.collections_url }}/beauty-makeup">Beauty &amp; Makeup</a></li>
                  <li><a class="mc-nav-drawer__sublink" href="{{ routes.collections_url }}/skincare">Skincare</a></li>
                  <li><a class="mc-nav-drawer__sublink" href="{{ routes.collections_url }}/haircare">Haircare</a></li>
                  <li><a class="mc-nav-drawer__sublink" href="{{ routes.collections_url }}/hosiery-innerwear">Hosiery &amp; Innerwear</a></li>
                  <li><a class="mc-nav-drawer__sublink" href="{{ routes.collections_url }}/toys-kids">Toys &amp; Kids</a></li>
                  <li><a class="mc-nav-drawer__sublink" href="{{ routes.collections_url }}/gift-articles">Gift Articles</a></li>
                  <li><a class="mc-nav-drawer__sublink" href="{{ routes.collections_url }}/imitation-jewellery">Imitation Jewellery</a></li>
                  <li><a class="mc-nav-drawer__sublink" href="{{ routes.collections_url }}/accessories-grooming">Accessories &amp; Grooming</a></li>
                {%- endif -%}
              </ul>
            </details>
          {%- elsif l_title_lower contains 'brand' -%}
            <details class="mc-nav-drawer__group">
              <summary class="mc-nav-drawer__link">{{ link.title | escape }} {% render 'icon', name: 'chevron', size: 14, class: 'mc-nav__chevron' %}</summary>
              <ul>
                {%- if hh_brands != blank and hh_brands.links.size > 0 -%}
                  {%- for blink in hh_brands.links -%}
                    <li><a class="mc-nav-drawer__sublink" href="{{ blink.url }}">{{ blink.title | escape }}</a></li>
                  {%- endfor -%}
                {%- else -%}
                  {%- assign drawer_brands = "Jockey:jockey,Van Heusen:van-heusen,Zoiro:zoiro,Bodycare:bodycare,Lady Care:lady-care,Swiss Beauty:swiss-beauty,Lakmé:lakme,Maybelline New York:maybelline-new-york,Faces Canada:faces-canada,Colorbar:colorbar,MARS Cosmetics:mars-cosmetics,Minimalist:minimalist,Dot & Key:dot-key,Cetaphil:cetaphil,Sebamed:sebamed,POND'S:ponds,NIVEA:nivea,Garnier:garnier,Pilgrim:pilgrim,Plix:plix,Lotus Herbals:lotus-herbals,L'Oréal Paris:loreal-paris,L'Oréal Professionnel:loreal-professionnel,Matrix:matrix,Wella Professionals:wella-professionals,VEGA:vega,Philips:philips,Sunny:sunny,Ghar Soaps:ghar-soaps" | split: ',' -%}
                  {%- for item in drawer_brands -%}
                    {%- assign b_parts = item | split: ':' -%}
                    <li><a class="mc-nav-drawer__sublink" href="{{ routes.collections_url }}/{{ b_parts[1] }}">{{ b_parts[0] }}</a></li>
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </details>
          {%- elsif link.links.size > 0 -%}
            <details class="mc-nav-drawer__group">
              <summary class="mc-nav-drawer__link">{{ link.title | escape }} {% render 'icon', name: 'chevron', size: 14, class: 'mc-nav__chevron' %}</summary>
              <ul>
                {%- for child in link.links -%}
                  <li><a class="mc-nav-drawer__sublink" href="{{ child.url }}">{{ child.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </details>
          {%- else -%}
            <a class="mc-nav-drawer__link" href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <a class="mc-nav-drawer__link" href="{{ routes.collections_url }}/beauty-makeup">Beauty &amp; Makeup</a>
        <a class="mc-nav-drawer__link" href="{{ routes.collections_url }}/skincare">Skincare</a>
