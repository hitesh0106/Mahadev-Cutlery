{%- comment -%}
  Site footer (static section rendered from layout/theme.liquid).
  - Brand block with logo text + honest tagline
  - Shop column (main-menu links)
  - Contact column: ONLY the store fields that are actually filled (never renders
    empty fields and never invents data). Address, phones, email, Instagram, Maps.
  - Support column (footer-menu) + policy links (rendered only if the policy pages exist)
  - Language selector + copyright with the current year
{%- endcomment -%}
{%- assign ft_main = linklists['main-menu'] -%}
{%- assign ft_footer = linklists['footer-menu'] -%}
{%- assign ft_logo = settings.logo_text -%}
{%- if ft_logo == blank -%}{%- assign ft_logo = shop.name -%}{%- endif -%}

<footer class="mc-footer" role="contentinfo">
  <div class="mc-container mc-footer__inner">
    <div class="mc-footer__grid">
      <div class="mc-footer__brand">
        <p class="mc-footer__logo">
          <span class="mc-logo__text">{{ ft_logo | escape }}</span>
          {%- if settings.logo_subline != blank -%}
            <span class="mc-logo__subline">{{ settings.logo_subline | escape }}</span>
          {%- endif -%}
        </p>
        <p class="mc-footer__tagline">{{ shop.name | escape }} &mdash; {{ 'footer.whatsapp_note' | t }}</p>
        <div class="mc-footer__social">
          {%- if settings.instagram_url != blank -%}
            <a class="mc-icon-btn" href="{{ settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
              {% render 'icon', name: 'instagram' %}
            </a>
          {%- endif -%}
          {%- if settings.social_link != blank -%}
            <a class="mc-icon-btn" href="{{ settings.social_link }}" target="_blank" rel="noopener" aria-label="{{ 'footer.follow' | t }}">
              {% render 'icon', name: 'arrow' %}
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- if ft_main != blank and ft_main.links.size > 0 -%}
        <nav class="mc-footer__col" aria-label="{{ 'footer.shop' | t }}">
          <h2 class="mc-footer__heading">{{ 'footer.shop' | t }}</h2>
          <ul class="mc-footer__list">
            {%- for link in ft_main.links limit: 8 -%}
              <li><a class="mc-footer__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <div class="mc-footer__col">
        <h2 class="mc-footer__heading">{{ 'footer.contact' | t }}</h2>
        {%- if settings.address_lines != blank -%}
          <address class="mc-footer__address">
            {%- assign ft_lines = settings.address_lines | newline_to_br | split: '<br />' -%}
            {%- for line in ft_lines -%}
              {%- assign ft_line = line | strip -%}
              {%- if ft_line != blank -%}
                <span class="mc-footer__address-line">{{ ft_line | escape }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if settings.maps_url != blank -%}
              <a class="mc-footer__link mc-footer__maps" href="{{ settings.maps_url }}" target="_blank" rel="noopener">Find us on Google Maps</a>
            {%- endif -%}
          </address>
        {%- endif -%}
        {%- if settings.phone_1 != blank -%}
          <a class="mc-footer__link" href="tel:{{ settings.phone_1 | strip }}">{{ settings.phone_1 | escape }}</a>
        {%- endif -%}
        {%- if settings.phone_2 != blank -%}
          <a class="mc-footer__link" href="tel:{{ settings.phone_2 | strip }}">{{ settings.phone_2 | escape }}</a>
        {%- endif -%}
        {%- if settings.email != blank -%}
          <a class="mc-footer__link" href="mailto:{{ settings.email | strip }}">{{ settings.email | escape }}</a>
        {%- endif -%}
        {%- if settings.store_hours != blank -%}
          <p class="mc-footer__hours"><span class="mc-footer__hours-label">{{ 'footer.store_hours' | t }}:</span> {{ settings.store_hours | escape }}</p>
        {%- endif -%}
      </div>

      {%- if ft_footer != blank and ft_footer.links.size > 0 -%}
        <nav class="mc-footer__col" aria-label="{{ 'footer.support' | t }}">
          <h2 class="mc-footer__heading">{{ 'footer.support' | t }}</h2>
          <ul class="mc-footer__list">
            {%- for link in ft_footer.links limit: 8 -%}
              <li><a class="mc-footer__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
          <ul class="mc-footer__list mc-footer__policies">
            {%- if shop.privacy_policy != blank -%}
              <li><a class="mc-footer__link" href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a></li>
            {%- endif -%}
            {%- if shop.refund_policy != blank -%}
              <li><a class="mc-footer__link" href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title | escape }}</a></li>
            {%- endif -%}
            {%- if shop.shipping_policy != blank -%}
              <li><a class="mc-footer__link" href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title | escape }}</a></li>
            {%- endif -%}
            {%- if shop.terms_of_service != blank -%}
              <li><a class="mc-footer__link" href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title | escape }}</a></li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    {%- assign ft_year = 'now' | date: '%Y' -%}
    <div class="mc-footer__bottom">
      <p class="mc-footer__copyright">{{ 'footer.copyright' | t: year: ft_year, shop_name: shop.name }}</p>
      {% render 'language-selector' %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Contact details come from Theme settings → Store information. Empty fields are never rendered. Menus come from Navigation (main-menu and footer-menu). Policy links appear only after you set policies in Settings → Policies."
    }
  ]
}
{% endschema %}
