{%- comment -%}
  Site footer — matches Image 4 reference design:
  - 5-column layout on desktop:
    1. Brand info with ◇ MAHADEV + CUTLERY & GIFT ARTICLES + store description + Instagram circle icon
    2. SHOP (Shop all, New arrivals, Offers, Brands A–Z)
    3. DEPARTMENTS (Skincare, Makeup, Haircare, Hosiery & Innerwear, Kids & Toys, Gift Articles)
    4. CUSTOMER CARE (Contact, Shipping policy, Refund policy, Privacy policy, Terms of service)
    5. VISIT US (Address with map-pin icon + View on Google Maps, phone numbers with phone icon, email with mail icon)
  - Bottom bar with copyright and Shopify Admin note
{%- endcomment -%}

{%- assign ft_logo = settings.logo_text | default: 'MAHADEV' -%}
{%- assign ft_sub = settings.logo_subline | default: 'CUTLERY & GIFT ARTICLES' -%}
{%- assign ft_instagram = settings.instagram_url | default: 'https://www.instagram.com/mahadev_cutlery/' -%}
{%- assign ft_maps = settings.maps_url | default: 'https://maps.app.goo.gl/P3AkDsq9bySkxAVbA' -%}
{%- assign ft_phone_1 = settings.phone_1 | default: '9898648776' -%}
{%- assign ft_phone_2 = settings.phone_2 | default: '9998268636' -%}
{%- assign ft_email = settings.email | default: 'mahadevcutlery@gmail.com' -%}
{%- assign ft_year = 'now' | date: '%Y' -%}

<footer class="mc-footer" role="contentinfo">
  <div class="mc-container mc-footer__inner">
    <div class="mc-footer__grid">
      <!-- Col 1: Brand -->
      <div class="mc-footer__brand">
        <div class="mc-footer__brand-head">
          <span class="mc-footer__brand-diamond" aria-hidden="true">&#9671;</span>
          <span class="mc-footer__brand-title">{{ ft_logo | escape }}</span>
        </div>
        <p class="mc-footer__brand-subtitle">{{ ft_sub | escape }}</p>
        <p class="mc-footer__brand-text">
          A multi-brand store for beauty, skincare, haircare, innerwear, kids' toys, gifts and imitation jewellery.
        </p>
        {%- if ft_instagram != blank -%}
          <div class="mc-footer__social-list">
            <a class="mc-footer__social-btn" href="{{ ft_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
              {% render 'icon', name: 'instagram', size: 16 %}
            </a>
          </div>
        {%- endif -%}
      </div>

      <!-- Col 2: SHOP -->
      <nav class="mc-footer__col mc-footer__col--shop" aria-label="Shop">
        <h3 class="mc-footer__heading">SHOP</h3>
        <ul class="mc-footer__links">
          <li><a href="{{ routes.all_products_collection_url }}">Shop all</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">New arrivals</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Offers</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Brands A&ndash;Z</a></li>
        </ul>
      </nav>

      <!-- Col 3: DEPARTMENTS -->
      <nav class="mc-footer__col mc-footer__col--depts" aria-label="Departments">
        <h3 class="mc-footer__heading">DEPARTMENTS</h3>
        <ul class="mc-footer__links">
          <li><a href="{{ routes.collections_url }}/skincare">Skincare</a></li>
          <li><a href="{{ routes.collections_url }}/beauty-makeup">Makeup</a></li>
          <li><a href="{{ routes.collections_url }}/haircare">Haircare</a></li>
          <li><a href="{{ routes.collections_url }}/hosiery-innerwear">Hosiery &amp; Innerwear</a></li>
          <li><a href="{{ routes.collections_url }}/toys-kids">Kids &amp; Toys</a></li>
          <li><a href="{{ routes.collections_url }}/gift-articles">Gift Articles</a></li>
        </ul>
      </nav>

      <!-- Col 4: CUSTOMER CARE -->
      <nav class="mc-footer__col mc-footer__col--care" aria-label="Customer Care">
        <h3 class="mc-footer__heading">CUSTOMER CARE</h3>
        <ul class="mc-footer__links">
          <li><a href="{{ routes.root_url }}pages/contact">Contact</a></li>
          <li><a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">Shipping policy</a></li>
          <li><a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">Refund policy</a></li>
          <li><a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy policy</a></li>
          <li><a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms of service</a></li>
        </ul>
      </nav>

      <!-- Col 5: VISIT US -->
      <div class="mc-footer__col mc-footer__col--visit">
        <h3 class="mc-footer__heading">VISIT US</h3>
        <div class="mc-footer__contact-items">
          <div class="mc-footer__contact-item">
            <span class="mc-footer__contact-icon">
              {% render 'icon', name: 'map-pin', size: 16 %}
            </span>
            <div class="mc-footer__contact-content">
              <address class="mc-footer__address">
                A-15, Shivalik Bungalows, Vastral Road, Opposite Ratanpura Gam, Vastral, Ahmedabad, Gujarat 382418, India
              </address>
              {%- if ft_maps != blank -%}
                <a class="mc-footer__maps-link" href="{{ ft_maps }}" target="_blank" rel="noopener">View on Google Maps</a>
              {%- endif -%}
            </div>
          </div>

          <div class="mc-footer__contact-item">
            <span class="mc-footer__contact-icon">
              {% render 'icon', name: 'phone', size: 15 %}
            </span>
            <div class="mc-footer__contact-content">
              <div class="mc-footer__phones">
                {%- if ft_phone_1 != blank -%}
                  <a class="mc-footer__link" href="tel:{{ ft_phone_1 | strip }}">{{ ft_phone_1 | escape }}</a>
                {%- endif -%}
                {%- if ft_phone_2 != blank -%}
                  {%- if ft_phone_1 != blank %}, {% endif -%}
                  <a class="mc-footer__link" href="tel:{{ ft_phone_2 | strip }}">{{ ft_phone_2 | escape }}</a>
                {%- endif -%}
              </div>
            </div>
          </div>

          {%- if ft_email != blank -%}
            <div class="mc-footer__contact-item">
              <span class="mc-footer__contact-icon">
                {% render 'icon', name: 'mail', size: 15 %}
              </span>
              <div class="mc-footer__contact-content">
                <a class="mc-footer__link" href="mailto:{{ ft_email | strip }}">{{ ft_email | escape }}</a>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mc-footer__bottom">
      <p class="mc-footer__copyright">&copy; {{ ft_year }} {{ ft_logo | escape }} {{ ft_sub | escape }}. All rights reserved.</p>
      <div class="mc-footer__bottom-right">
        <p class="mc-footer__admin-notice">Policies are listed automatically from Shopify Admin.</p>
        {% render 'language-selector' %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Footer styling and layout matching Image 4. Contact details and links are dynamically loaded with fallbacks."
    }
  ]
}
{% endschema %}
