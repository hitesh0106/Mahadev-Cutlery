{%- comment -%}
  Shop by department — the reference grid (2 featured cards + 3-across rows).
  Blocks: collection picker (wins when picked) OR a text handle for the
  pre-launch state → /collections/<handle>; title, sub-line, optional note
  and an image that falls back to the bundled department placeholder chosen
  by handle. Only merchant-configured blocks render — nothing auto-generates.
  NO kitchenware/cutlery department exists (the eight approved only).
{%- endcomment -%}
<section class="mc-section mc-departments" id="{{ section.settings.anchor_id | default: 'departments' }}" data-testid="departments-section">
  <div class="mc-container">
    <div class="mc-section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="mc-eyebrow">— {{ section.settings.eyebrow | escape | upcase }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="mc-section__heading mc-section__heading--flush">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.action_label != blank -%}
        <a class="mc-action-link" href="{{ section.settings.action_link | default: routes.all_products_collection_url }}">
          {{ section.settings.action_label | escape | upcase }}
          <svg class="mc-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>

    <ul class="mc-departments__grid">
      {%- if section.blocks.size >= 8 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            case forloop.index
              when 1
                assign slot_handle = 'beauty-makeup'
                assign slot_title = 'Makeup & Cosmetics'
                assign slot_sub = 'Lips, eyes, face'
                assign slot_img = 'dept-makeup.jpg'
              when 2
                assign slot_handle = 'skincare'
                assign slot_title = 'Skincare'
                assign slot_sub = 'Cleanse, treat, protect'
                assign slot_img = 'dept-beauty.jpg'
              when 3
                assign slot_handle = 'haircare'
                assign slot_title = 'Haircare'
                assign slot_sub = 'Everyday & professional'
                assign slot_img = 'dept-haircare.jpg'
              when 4
                assign slot_handle = 'hosiery-innerwear'
                assign slot_title = 'Hosiery & Innerwear'
                assign slot_sub = 'Men, women & kids'
                assign slot_img = 'dept-innerwear.jpg'
              when 5
                assign slot_handle = 'toys-kids'
                assign slot_title = 'Kids & Toys'
                assign slot_sub = 'Play & learn'
                assign slot_img = 'dept-kids.jpg'
              when 6
                assign slot_handle = 'gift-articles'
                assign slot_title = 'Gift Articles'
                assign slot_sub = 'For every occasion'
                assign slot_img = 'dept-gifts.jpg'
              when 7
                assign slot_handle = 'imitation-jewellery'
                assign slot_title = 'Imitation Jewellery'
                assign slot_sub = 'Everyday sparkle'
                assign slot_img = 'dept-jewellery.jpg'
              when 8
                assign slot_handle = 'accessories-grooming'
                assign slot_title = 'Beauty Tools & Grooming'
                assign slot_sub = 'Brushes, combs, trimmers'
                assign slot_img = 'dept-tools.jpg'
              else
                assign slot_handle = 'beauty-makeup'
                assign slot_title = 'Makeup & Cosmetics'
                assign slot_sub = 'Lips, eyes, face'
                assign slot_img = 'dept-makeup.jpg'
            endcase

            assign dg_collection = block.settings.collection
            assign dg_handle = block.settings.handle
            if dg_collection != blank
              assign dg_href = dg_collection.url
              assign dg_handle_key = dg_collection.handle
            elsif dg_handle != blank
              assign dg_handle_key = dg_handle
              assign dg_href = routes.collections_url | append: '/' | append: dg_handle
            else
              assign dg_handle_key = slot_handle
              assign dg_href = routes.collections_url | append: '/' | append: slot_handle
            endif

            assign dg_title = block.settings.title | default: dg_collection.title | default: slot_title
            assign dg_sub = block.settings.sub | default: slot_sub
            assign dg_alt = dg_title
          -%}
          <li class="mc-dept-cell" {{ block.shopify_attributes }}>
            <a class="mc-dept-cell__link" href="{{ dg_href }}">
              <span class="mc-dept-cell__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 900 | image_tag:
                    loading: 'eager',
                    sizes: '(min-width: 990px) 33vw, (min-width: 640px) 25vw, 50vw',
                    widths: '300, 600, 900',
                    class: 'mc-dept-cell__img',
                    alt: dg_alt
                  }}
                {%- else -%}
                  {%- liquid
                    case dg_handle_key
                      when 'beauty-makeup'
                        assign fallback_asset = 'dept-makeup.jpg'
                      when 'skincare'
                        assign fallback_asset = 'dept-beauty.jpg'
                      when 'haircare'
                        assign fallback_asset = 'dept-haircare.jpg'
                      when 'hosiery-innerwear'
                        assign fallback_asset = 'dept-innerwear.jpg'
                      when 'toys-kids'
                        assign fallback_asset = 'dept-kids.jpg'
                      when 'gift-articles'
                        assign fallback_asset = 'dept-gifts.jpg'
                      when 'imitation-jewellery'
                        assign fallback_asset = 'dept-jewellery.jpg'
                      when 'accessories-grooming'
                        assign fallback_asset = 'dept-tools.jpg'
                      else
                        assign fallback_asset = slot_img
                    endcase
                  -%}
                  <img
                    class="mc-dept-cell__img"
                    src="{{ fallback_asset | asset_url }}"
                    alt="{{ dg_alt | escape }}"
                    loading="eager"
                    width="600"
                    height="800"
                  >
                {%- endif -%}
              </span>
              <span class="mc-dept-cell__body">
                <span class="mc-dept-cell__info">
                  <span class="mc-dept-cell__title">{{ dg_title | escape }}</span>
                  {%- if dg_sub != blank -%}
                    <span class="mc-dept-cell__sub">{{ dg_sub | escape }}</span>
                  {%- endif -%}
                </span>
                <span class="mc-dept-cell__arrow" aria-hidden="true">
                  <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Guaranteed fallback canonical 8 departments {%- endcomment -%}
        <li class="mc-dept-cell">
          <a class="mc-dept-cell__link" href="{{ routes.collections_url }}/beauty-makeup">
            <span class="mc-dept-cell__media">
              <img class="mc-dept-cell__img" src="{{ 'dept-makeup.jpg' | asset_url }}" alt="Makeup & Cosmetics" loading="eager" width="600" height="800">
            </span>
            <span class="mc-dept-cell__body">
              <span class="mc-dept-cell__info">
                <span class="mc-dept-cell__title">Makeup & Cosmetics</span>
                <span class="mc-dept-cell__sub">Lips, eyes, face</span>
              </span>
              <span class="mc-dept-cell__arrow" aria-hidden="true">
                <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </span>
          </a>
        </li>
        <li class="mc-dept-cell">
          <a class="mc-dept-cell__link" href="{{ routes.collections_url }}/skincare">
            <span class="mc-dept-cell__media">
              <img class="mc-dept-cell__img" src="{{ 'dept-beauty.jpg' | asset_url }}" alt="Skincare" loading="eager" width="600" height="800">
            </span>
            <span class="mc-dept-cell__body">
              <span class="mc-dept-cell__info">
                <span class="mc-dept-cell__title">Skincare</span>
                <span class="mc-dept-cell__sub">Cleanse, treat, protect</span>
              </span>
              <span class="mc-dept-cell__arrow" aria-hidden="true">
                <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </span>
          </a>
        </li>
        <li class="mc-dept-cell">
          <a class="mc-dept-cell__link" href="{{ routes.collections_url }}/haircare">
            <span class="mc-dept-cell__media">
              <img class="mc-dept-cell__img" src="{{ 'dept-haircare.jpg' | asset_url }}" alt="Haircare" loading="eager" width="600" height="800">
            </span>
            <span class="mc-dept-cell__body">
              <span class="mc-dept-cell__info">
                <span class="mc-dept-cell__title">Haircare</span>
                <span class="mc-dept-cell__sub">Everyday & professional</span>
              </span>
              <span class="mc-dept-cell__arrow" aria-hidden="true">
                <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </span>
          </a>
        </li>
        <li class="mc-dept-cell">
          <a class="mc-dept-cell__link" href="{{ routes.collections_url }}/hosiery-innerwear">
            <span class="mc-dept-cell__media">
              <img class="mc-dept-cell__img" src="{{ 'dept-innerwear.jpg' | asset_url }}" alt="Hosiery & Innerwear" loading="eager" width="600" height="800">
            </span>
            <span class="mc-dept-cell__body">
              <span class="mc-dept-cell__info">
                <span class="mc-dept-cell__title">Hosiery & Innerwear</span>
                <span class="mc-dept-cell__sub">Men, women & kids</span>
              </span>
              <span class="mc-dept-cell__arrow" aria-hidden="true">
                <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </span>
          </a>
        </li>
        <li class="mc-dept-cell">
          <a class="mc-dept-cell__link" href="{{ routes.collections_url }}/toys-kids">
            <span class="mc-dept-cell__media">
              <img class="mc-dept-cell__img" src="{{ 'dept-kids.jpg' | asset_url }}" alt="Kids & Toys" loading="eager" width="600" height="800">
            </span>
            <span class="mc-dept-cell__body">
              <span class="mc-dept-cell__info">
                <span class="mc-dept-cell__title">Kids & Toys</span>
                <span class="mc-dept-cell__sub">Play & learn</span>
              </span>
              <span class="mc-dept-cell__arrow" aria-hidden="true">
                <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </span>
          </a>
        </li>
        <li class="mc-dept-cell">
          <a class="mc-dept-cell__link" href="{{ routes.collections_url }}/gift-articles">
            <span class="mc-dept-cell__media">
              <img class="mc-dept-cell__img" src="{{ 'dept-gifts.jpg' | asset_url }}" alt="Gift Articles" loading="eager" width="600" height="800">
            </span>
            <span class="mc-dept-cell__body">
              <span class="mc-dept-cell__info">
                <span class="mc-dept-cell__title">Gift Articles</span>
                <span class="mc-dept-cell__sub">For every occasion</span>
              </span>
              <span class="mc-dept-cell__arrow" aria-hidden="true">
                <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </span>
          </a>
        </li>
        <li class="mc-dept-cell">
          <a class="mc-dept-cell__link" href="{{ routes.collections_url }}/imitation-jewellery">
            <span class="mc-dept-cell__media">
              <img class="mc-dept-cell__img" src="{{ 'dept-jewellery.jpg' | asset_url }}" alt="Imitation Jewellery" loading="eager" width="600" height="800">
            </span>
            <span class="mc-dept-cell__body">
              <span class="mc-dept-cell__info">
                <span class="mc-dept-cell__title">Imitation Jewellery</span>
                <span class="mc-dept-cell__sub">Everyday sparkle</span>
              </span>
              <span class="mc-dept-cell__arrow" aria-hidden="true">
                <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </span>
          </a>
        </li>
        <li class="mc-dept-cell">
          <a class="mc-dept-cell__link" href="{{ routes.collections_url }}/accessories-grooming">
            <span class="mc-dept-cell__media">
              <img class="mc-dept-cell__img" src="{{ 'dept-tools.jpg' | asset_url }}" alt="Beauty Tools & Grooming" loading="eager" width="600" height="800">
            </span>
            <span class="mc-dept-cell__body">
              <span class="mc-dept-cell__info">
                <span class="mc-dept-cell__title">Beauty Tools & Grooming</span>
                <span class="mc-dept-cell__sub">Brushes, combs, trimmers</span>
              </span>
              <span class="mc-dept-cell__arrow" aria-hidden="true">
                <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </span>
          </a>
        </li>
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Department grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Departments"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by department"
    },
    {
      "type": "text",
      "id": "action_label",
      "label": "Header action label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "action_link",
      "label": "Header action link"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "HTML anchor id",
      "default": "departments"
    }
  ],
  "blocks": [
    {
      "type": "department",
      "name": "Department card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (optional)",
          "info": "The EIGHT approved departments: Beauty & Makeup, Skincare, Haircare, Hosiery & Innerwear, Toys & Kids, Gift Articles, Imitation Jewellery, Accessories & Grooming. No kitchenware/cutlery department exists."
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Collection handle (fallback)",
          "info": "Used until a collection is picked, e.g. beauty-makeup → /collections/beauty-makeup."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override (optional)"
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Sub-line (optional)",
          "info": "e.g. “Lips, eyes, face” under Beauty & Makeup."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override (optional)"
        },
        {
          "type": "text",
          "id": "rule_text",
          "label": "Small note (optional)",
          "info": "e.g. a brand rule like “Zoiro — men's innerwear only”."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Department grid",
      "blocks": []
    }
  ]
}
{% endschema %}
