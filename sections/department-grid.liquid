{%- comment -%}
  Shop by department — reference editorial grid (3+5 cards).
  Supports BOTH:
  1. Section-level independent collection pickers (collection_1 to collection_8)
     so the merchant can select the exact collection for Skincare, Hosiery,
     Beauty, Haircare, etc. directly in the Theme Editor right panel!
  2. Block-level overrides (section.blocks) for merchants who want to add, remove,
     or reorder department cards dynamically.

  Each card (including the title, image, and circular arrow) links directly
  to its own independent collection URL.
{%- endcomment -%}
{%- liquid
  assign has_custom_blocks = false
  if section.blocks.size > 0
    assign has_custom_blocks = true
  endif
-%}
<section class="mc-section mc-departments" id="{{ section.settings.anchor_id | default: 'departments' }}" data-testid="departments-section">
  <div class="mc-container">
    <div class="mc-section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="mc-eyebrow">— {{ section.settings.eyebrow | escape | upcase }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="mc-section__heading mc-section__heading--flush">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.action_label != blank -%}
        <a class="mc-action-link" href="{{ section.settings.action_link | default: routes.all_products_collection_url }}">
          {{ section.settings.action_label | escape | upcase }}
          <svg class="mc-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>

    <ul class="mc-departments__grid">
      {%- if has_custom_blocks -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.enabled == false -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign slot_handle = 'beauty-makeup'
            assign slot_title = 'Beauty & Makeup'
            assign slot_sub = 'Lips, eyes, face'
            assign slot_img = 'dept-makeup.jpg'

            case forloop.index
              when 1
                assign slot_handle = 'beauty-makeup'
                assign slot_title = 'Beauty & Makeup'
                assign slot_sub = 'Lips, eyes, face'
                assign slot_img = 'dept-makeup.jpg'
              when 2
                assign slot_handle = 'skincare'
                assign slot_title = 'Skincare'
                assign slot_sub = 'Cleanse, treat, protect'
                assign slot_img = 'dept-beauty.jpg'
              when 3
                assign slot_handle = 'haircare'
                assign slot_title = 'Haircare'
                assign slot_sub = 'Everyday & professional'
                assign slot_img = 'dept-haircare.jpg'
              when 4
                assign slot_handle = 'hosiery-innerwear'
                assign slot_title = 'Hosiery & Innerwear'
                assign slot_sub = 'Men, women & kids'
                assign slot_img = 'dept-innerwear.jpg'
              when 5
                assign slot_handle = 'toys-kids'
                assign slot_title = 'Toys & Kids'
                assign slot_sub = 'Play & learn'
                assign slot_img = 'dept-kids.jpg'
              when 6
                assign slot_handle = 'gift-articles'
                assign slot_title = 'Gift Articles'
                assign slot_sub = 'For every occasion'
                assign slot_img = 'dept-gifts.jpg'
              when 7
                assign slot_handle = 'imitation-jewellery'
                assign slot_title = 'Imitation Jewellery'
                assign slot_sub = 'Everyday sparkle'
                assign slot_img = 'dept-jewellery.jpg'
              when 8
                assign slot_handle = 'accessories-grooming'
                assign slot_title = 'Accessories & Grooming'
                assign slot_sub = 'Brushes, combs, trimmers'
                assign slot_img = 'dept-tools.jpg'
            endcase

            assign dg_collection = block.settings.collection
            assign dg_handle = block.settings.handle
            assign dg_href = ''
            assign dg_handle_key = slot_handle

            if dg_collection != blank
              assign dg_href = dg_collection.url
              assign dg_handle_key = dg_collection.handle
            elsif block.settings.link != blank
              assign dg_href = block.settings.link
            elsif dg_handle != blank
              assign dg_handle_key = dg_handle
              assign dg_href = routes.collections_url | append: '/' | append: dg_handle
            endif

            assign dg_title = block.settings.title | default: dg_collection.title | default: slot_title
            assign dg_sub = block.settings.sub | default: slot_sub
            assign dg_alt = dg_title
          -%}
          <li class="mc-dept-cell" {{ block.shopify_attributes }}>
            {%- if dg_href != blank -%}
              <a class="mc-dept-cell__link" href="{{ dg_href }}">
            {%- else -%}
              <div class="mc-dept-cell__link mc-dept-cell__link--static">
            {%- endif -%}
              <span class="mc-dept-cell__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 900 | image_tag:
                    loading: 'eager',
                    sizes: '(min-width: 990px) 33vw, (min-width: 640px) 25vw, 50vw',
                    widths: '300, 600, 900',
                    class: 'mc-dept-cell__img',
                    alt: dg_alt
                  }}
                {%- elsif dg_collection != blank and dg_collection.image != blank -%}
                  {{ dg_collection.image | image_url: width: 900 | image_tag:
                    loading: 'eager',
                    sizes: '(min-width: 990px) 33vw, (min-width: 640px) 25vw, 50vw',
                    widths: '300, 600, 900',
                    class: 'mc-dept-cell__img',
                    alt: dg_alt
                  }}
                {%- else -%}
                  {%- liquid
                    case dg_handle_key
                      when 'beauty-makeup'
                        assign fallback_asset = 'dept-makeup.jpg'
                      when 'skincare'
                        assign fallback_asset = 'dept-beauty.jpg'
                      when 'haircare'
                        assign fallback_asset = 'dept-haircare.jpg'
                      when 'hosiery-innerwear'
                        assign fallback_asset = 'dept-innerwear.jpg'
                      when 'toys-kids'
                        assign fallback_asset = 'dept-kids.jpg'
                      when 'gift-articles'
                        assign fallback_asset = 'dept-gifts.jpg'
                      when 'imitation-jewellery'
                        assign fallback_asset = 'dept-jewellery.jpg'
                      when 'accessories-grooming'
                        assign fallback_asset = 'dept-tools.jpg'
                      else
                        assign fallback_asset = slot_img
                    endcase
                  -%}
                  <img
                    class="mc-dept-cell__img"
                    src="{{ fallback_asset | asset_url }}"
                    alt="{{ dg_alt | escape }}"
                    loading="eager"
                    width="600"
                    height="800"
                  >
                {%- endif -%}
              </span>
              <span class="mc-dept-cell__body">
                <span class="mc-dept-cell__info">
                  <span class="mc-dept-cell__title">{{ dg_title | escape }}</span>
                  {%- if dg_sub != blank -%}
                    <span class="mc-dept-cell__sub">{{ dg_sub | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.rule_text != blank -%}
                    <span class="mc-dept-cell__note">{{ block.settings.rule_text | escape }}</span>
                  {%- endif -%}
                </span>
                {%- if dg_href != blank -%}
                  <span class="mc-dept-cell__arrow" aria-hidden="true">
                    <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </span>
                {%- endif -%}
              </span>
            {%- if dg_href != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}
          Independent 8 Departments configured via Section Settings.
          Allows the merchant to pick the collection directly in the Theme Editor right panel!
        {%- endcomment -%}
        {%- for i in (1..8) -%}
          {%- liquid
            case i
              when 1
                assign d_col = section.settings.collection_1
                assign d_custom_img = section.settings.image_1
                assign d_handle = 'beauty-makeup'
                assign d_default_title = 'Beauty & Makeup'
                assign d_default_sub = 'Lips, eyes, face'
                assign d_asset = 'dept-makeup.jpg'
                assign d_custom_title = section.settings.title_1
              when 2
                assign d_col = section.settings.collection_2
                assign d_custom_img = section.settings.image_2
                assign d_handle = 'skincare'
                assign d_default_title = 'Skincare'
                assign d_default_sub = 'Cleanse, treat, protect'
                assign d_asset = 'dept-beauty.jpg'
                assign d_custom_title = section.settings.title_2
              when 3
                assign d_col = section.settings.collection_3
                assign d_custom_img = section.settings.image_3
                assign d_handle = 'haircare'
                assign d_default_title = 'Haircare'
                assign d_default_sub = 'Everyday & professional'
                assign d_asset = 'dept-haircare.jpg'
                assign d_custom_title = section.settings.title_3
              when 4
                assign d_col = section.settings.collection_4
                assign d_custom_img = section.settings.image_4
                assign d_handle = 'hosiery-innerwear'
                assign d_default_title = 'Hosiery & Innerwear'
                assign d_default_sub = 'Men, women & kids'
                assign d_asset = 'dept-innerwear.jpg'
                assign d_custom_title = section.settings.title_4
              when 5
                assign d_col = section.settings.collection_5
                assign d_custom_img = section.settings.image_5
                assign d_handle = 'toys-kids'
                assign d_default_title = 'Toys & Kids'
                assign d_default_sub = 'Play & learn'
                assign d_asset = 'dept-kids.jpg'
                assign d_custom_title = section.settings.title_5
              when 6
                assign d_col = section.settings.collection_6
                assign d_custom_img = section.settings.image_6
                assign d_handle = 'gift-articles'
                assign d_default_title = 'Gift Articles'
                assign d_default_sub = 'For every occasion'
                assign d_asset = 'dept-gifts.jpg'
                assign d_custom_title = section.settings.title_6
              when 7
                assign d_col = section.settings.collection_7
                assign d_custom_img = section.settings.image_7
                assign d_handle = 'imitation-jewellery'
                assign d_default_title = 'Imitation Jewellery'
                assign d_default_sub = 'Everyday sparkle'
                assign d_asset = 'dept-jewellery.jpg'
                assign d_custom_title = section.settings.title_7
              when 8
                assign d_col = section.settings.collection_8
                assign d_custom_img = section.settings.image_8
                assign d_handle = 'accessories-grooming'
                assign d_default_title = 'Accessories & Grooming'
                assign d_default_sub = 'Brushes, combs, trimmers'
                assign d_asset = 'dept-tools.jpg'
                assign d_custom_title = section.settings.title_8
            endcase

            assign d_href = ''
            if d_col != blank
              assign d_href = d_col.url
            else
              assign d_href = routes.collections_url | append: '/' | append: d_handle
            endif

            assign d_title = d_custom_title | default: d_col.title | default: d_default_title
            assign d_sub = d_default_sub
          -%}
          <li class="mc-dept-cell">
            {%- if d_href != blank -%}
              <a class="mc-dept-cell__link" href="{{ d_href }}" aria-label="{{ d_title | escape }}">
            {%- else -%}
              <div class="mc-dept-cell__link mc-dept-cell__link--static">
            {%- endif -%}
              <span class="mc-dept-cell__media">
                {%- if d_custom_img != blank -%}
                  {{ d_custom_img | image_url: width: 900 | image_tag:
                    loading: 'eager',
                    sizes: '(min-width: 990px) 33vw, (min-width: 640px) 25vw, 50vw',
                    widths: '300, 600, 900',
                    class: 'mc-dept-cell__img',
                    alt: d_title | escape
                  }}
                {%- elsif d_col != blank and d_col.image != blank -%}
                  {{ d_col.image | image_url: width: 900 | image_tag:
                    loading: 'eager',
                    sizes: '(min-width: 990px) 33vw, (min-width: 640px) 25vw, 50vw',
                    widths: '300, 600, 900',
                    class: 'mc-dept-cell__img',
                    alt: d_title | escape
                  }}
                {%- else -%}
                  <img
                    class="mc-dept-cell__img"
                    src="{{ d_asset | asset_url }}"
                    alt="{{ d_title | escape }}"
                    loading="eager"
                    width="600"
                    height="800"
                  >
                {%- endif -%}
              </span>
              <span class="mc-dept-cell__body">
                <span class="mc-dept-cell__info">
                  <span class="mc-dept-cell__title">{{ d_title | escape }}</span>
                  {%- if d_sub != blank -%}
                    <span class="mc-dept-cell__sub">{{ d_sub | escape }}</span>
                  {%- endif -%}
                </span>
                {%- if d_href != blank -%}
                  <span class="mc-dept-cell__arrow" aria-hidden="true">
                    <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </span>
                {%- endif -%}
              </span>
            {%- if d_href != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Department grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Departments"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by department"
    },
    {
      "type": "text",
      "id": "action_label",
      "label": "Shop All label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "action_link",
      "label": "Shop All link",
      "info": "Independently configurable URL for the Shop All button (defaults to /collections if left blank)."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "HTML anchor id",
      "default": "departments"
    },
    {
      "type": "header",
      "content": "1. Beauty & Makeup"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Beauty & Makeup Collection",
      "info": "Select your independent Beauty & Makeup collection."
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Title override",
      "placeholder": "Beauty & Makeup"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image override (optional)"
    },
    {
      "type": "header",
      "content": "2. Skincare"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Skincare Collection",
      "info": "Select your independent Skincare collection."
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Title override",
      "placeholder": "Skincare"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image override (optional)"
    },
    {
      "type": "header",
      "content": "3. Haircare"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Haircare Collection",
      "info": "Select your independent Haircare collection."
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Title override",
      "placeholder": "Haircare"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image override (optional)"
    },
    {
      "type": "header",
      "content": "4. Hosiery & Innerwear"
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "Hosiery & Innerwear Collection",
      "info": "Select your independent Hosiery & Innerwear collection."
    },
    {
      "type": "text",
      "id": "title_4",
      "label": "Title override",
      "placeholder": "Hosiery & Innerwear"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image override (optional)"
    },
    {
      "type": "header",
      "content": "5. Toys & Kids"
    },
    {
      "type": "collection",
      "id": "collection_5",
      "label": "Toys & Kids Collection",
      "info": "Select your independent Toys & Kids collection."
    },
    {
      "type": "text",
      "id": "title_5",
      "label": "Title override",
      "placeholder": "Toys & Kids"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image override (optional)"
    },
    {
      "type": "header",
      "content": "6. Gift Articles"
    },
    {
      "type": "collection",
      "id": "collection_6",
      "label": "Gift Articles Collection",
      "info": "Select your independent Gift Articles collection."
    },
    {
      "type": "text",
      "id": "title_6",
      "label": "Title override",
      "placeholder": "Gift Articles"
    },
    {
      "type": "image_picker",
      "id": "image_6",
      "label": "Image override (optional)"
    },
    {
      "type": "header",
      "content": "7. Imitation Jewellery"
    },
    {
      "type": "collection",
      "id": "collection_7",
      "label": "Imitation Jewellery Collection",
      "info": "Select your independent Imitation Jewellery collection."
    },
    {
      "type": "text",
      "id": "title_7",
      "label": "Title override",
      "placeholder": "Imitation Jewellery"
    },
    {
      "type": "image_picker",
      "id": "image_7",
      "label": "Image override (optional)"
    },
    {
      "type": "header",
      "content": "8. Accessories & Grooming"
    },
    {
      "type": "collection",
      "id": "collection_8",
      "label": "Accessories & Grooming Collection",
      "info": "Select your independent Accessories & Grooming collection."
    },
    {
      "type": "text",
      "id": "title_8",
      "label": "Title override",
      "placeholder": "Accessories & Grooming"
    },
    {
      "type": "image_picker",
      "id": "image_8",
      "label": "Image override (optional)"
    }
  ],
  "blocks": [
    {
      "type": "department",
      "name": "Department card",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Enable department card",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "Department title",
          "info": "Leave blank to use the selected collection title."
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Subtitle",
          "info": "e.g. “Lips, eyes, face” under Beauty & Makeup."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image picker",
          "info": "Image for this department card. Falls back to collection featured image or bundled asset."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Shopify collection",
          "info": "Select the independent Shopify collection for this department. Takes top priority."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional custom URL",
          "info": "Used when no collection is selected above."
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Collection handle (legacy fallback)",
          "info": "E.g. beauty-makeup → /collections/beauty-makeup."
        },
        {
          "type": "text",
          "id": "rule_text",
          "label": "Small note (optional)",
          "info": "e.g. a brand rule like “Zoiro — men's innerwear only”."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Department grid"
    }
  ]
}
{% endschema %}
