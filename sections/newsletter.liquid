{%- comment -%}
  Newsletter signup — uses Shopify's native customer form (accepts_marketing).
  Matches reference design (Image 4):
  - 2-column layout (Left: eyebrow, serif heading, subtitle; Right: input + SUBSCRIBE → button).
  - Soft cream background.
{%- endcomment -%}
{%- assign nl_eyebrow = section.settings.eyebrow | default: 'NEWSLETTER' -%}
{%- assign nl_heading = section.settings.heading | default: 'Be the first to know' -%}
{%- assign nl_sub = section.settings.subtitle | default: 'New arrivals and store updates. Unsubscribe any time.' -%}
{%- assign nl_btn = section.settings.button_label | default: 'SUBSCRIBE' -%}
{%- assign nl_placeholder = section.settings.placeholder | default: 'Your email address' -%}

<section class="mc-newsletter" id="newsletter">
  <div class="mc-container mc-newsletter__inner">
    <div class="mc-newsletter__text">
      {%- if nl_eyebrow != blank -%}
        <div class="mc-newsletter__eyebrow">
          <span class="mc-newsletter__dash" aria-hidden="true">&mdash;</span>
          <span>{{ nl_eyebrow | escape }}</span>
        </div>
      {%- endif -%}
      <h2 class="mc-newsletter__heading">{{ nl_heading | escape }}</h2>
      {%- if nl_sub != blank -%}
        <p class="mc-newsletter__subtitle">{{ nl_sub | escape }}</p>
      {%- endif -%}
    </div>

    <div class="mc-newsletter__form-wrap">
      {%- form 'customer', id: 'mc-newsletter-form', class: 'mc-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <div class="mc-newsletter__group">
          <label class="mc-sr-only" for="mc-newsletter-email">{{ nl_placeholder | escape }}</label>
          <input
            type="email"
            class="mc-newsletter__input"
            id="mc-newsletter-email"
            name="contact[email]"
            placeholder="{{ nl_placeholder | escape }}"
            autocomplete="email"
            required
          >
          <button type="submit" class="mc-newsletter__btn">
            <span>{{ nl_btn | escape }}</span>
            <span class="mc-newsletter__arrow" aria-hidden="true">&rarr;</span>
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="mc-newsletter__success" role="status">{{ 'newsletter.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="mc-newsletter__error" role="alert">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEWSLETTER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Be the first to know"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "New arrivals and store updates. Unsubscribe any time."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SUBSCRIBE"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
