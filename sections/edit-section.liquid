{%- comment -%}
  Edit story — split editorial section (image + eyebrow/title/text + chip
  pills + optional two product cards). Three instances in the reference
  design: Beauty & Skincare, Hosiery & Innerwear, Gifts/Toys/Jewellery.
  Chips: label + optional link; without a link the chip is a static pill
  (never a dead button). Product cards render only when a collection with
  products is picked — nothing is invented.
{%- endcomment -%}
{%- liquid
  assign es_has_content = false
  if section.settings.eyebrow != blank or section.settings.title != blank
    assign es_has_content = true
  endif
  assign es_rendered = 0
  for block in section.blocks
    if block.settings.label != blank
      assign es_rendered = es_rendered | plus: 1
    endif
  endfor
-%}
{%- if es_has_content -%}
  {%- liquid
    case section.settings.tone
      when 'warm'
        assign es_tone_class = 'mc-section--soft'
      when 'cream'
        assign es_tone_class = 'mc-section--cream'
      when 'blush'
        assign es_tone_class = 'mc-section--blush'
      else
        assign es_tone_class = ''
    endcase
  -%}
  <section class="mc-section {{ es_tone_class }} mc-edit{% if section.settings.image_side == 'right' %} mc-edit--right{% endif %}" id="{{ section.settings.anchor_id | default: section.id }}" data-testid="edit-section">
    <div class="mc-container mc-edit__inner">
      <div class="mc-edit__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag:
            loading: 'eager',
            sizes: '(min-width: 990px) 45vw, 100vw',
            widths: '400, 600, 900',
            class: 'mc-edit__img',
            alt: section.settings.image.alt | default: section.settings.title
          }}
        {%- else -%}
          <img class="mc-edit__img" src="{{ section.settings.fallback_image | default: 'editorial-skincare.jpg' | asset_url }}" alt="{{ section.settings.title | escape }}" loading="eager" width="900" height="1125">
        {%- endif -%}
      </div>

      <div class="mc-edit__body">
        <div class="mc-edit__copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="mc-eyebrow">— {{ section.settings.eyebrow | escape | upcase }}</p>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="mc-edit__title">{{ section.settings.title | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="mc-edit__text">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>

        {%- if es_rendered > 0 -%}
          <div class="mc-edit__chips">
            {%- for block in section.blocks -%}
              {%- assign es_label = block.settings.label -%}
              {%- if es_label == blank -%}{%- continue -%}{%- endif -%}
              {%- if block.settings.link != blank -%}
                <a class="mc-chip" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ es_label | escape }}</a>
              {%- else -%}
                <span class="mc-chip mc-chip--static" {{ block.shopify_attributes }}>{{ es_label | escape }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- liquid
          assign es_collection = section.settings.collection
          assign has_es_products = false
          if es_collection != blank and es_collection.products_count > 0
            assign has_es_products = true
          endif

          assign sec_anchor = section.settings.anchor_id | downcase
          assign sec_eyebrow = section.settings.eyebrow | downcase
          assign sec_title = section.settings.title | downcase
        -%}

        <ul class="mc-edit__products">
          {%- if has_es_products -%}
            {%- for es_product in es_collection.products limit: 2 -%}
              <li>
                {% render 'product-card', card_product: es_product, show_vendor: true, reveal: false %}
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- if sec_anchor contains 'inner' or sec_eyebrow contains 'hosiery' or sec_eyebrow contains 'inner' or sec_title contains 'comfort' -%}
              {%- comment -%} Sample card 1: Men's cotton brief, pack of 2 {%- endcomment -%}
              <li>
                <article class="mc-card">
                  <div class="mc-card__media-wrap">
                    <a class="mc-card__media" href="{{ routes.collections_url }}/hosiery-innerwear" aria-label="Men's cotton brief, pack of 2">
                      <img class="mc-card__img" src="{{ 'dept-innerwear.jpg' | asset_url }}" alt="Men's cotton brief, pack of 2" width="600" height="600" loading="eager">
                    </a>
                    <div class="mc-card__wishlist">
                      <button type="button" class="mc-wl-btn" data-mc-wishlist aria-label="Save to wishlist" onclick="this.classList.toggle('is-active')">
                        <span class="mc-wl-btn__icons" aria-hidden="true">
                          {% render 'icon', name: 'heart', class: 'mc-wl-btn__outline' %}
                          {% render 'icon', name: 'heart-filled', class: 'mc-wl-btn__filled' %}
                        </span>
                      </button>
                    </div>
                  </div>
                  <div class="mc-card__body">
                    <p class="mc-card__vendor">SAMPLE BRAND</p>
                    <h3 class="mc-card__title">
                      <a href="{{ routes.collections_url }}/hosiery-innerwear">Men's cotton brief, pack of 2</a>
                    </h3>
                    <div class="mc-card__price">
                      <span class="mc-price">₹399</span>
                    </div>
                  </div>
                </article>
              </li>
              {%- comment -%} Sample card 2: Nourishing shampoo & conditioner set {%- endcomment -%}
              <li>
                <article class="mc-card">
                  <div class="mc-card__media-wrap">
                    <a class="mc-card__media" href="{{ routes.collections_url }}/haircare" aria-label="Nourishing shampoo & conditioner set">
                      <img class="mc-card__img" src="{{ 'dept-haircare.jpg' | asset_url }}" alt="Nourishing shampoo & conditioner set" width="600" height="600" loading="eager">
                    </a>
                    <div class="mc-card__wishlist">
                      <button type="button" class="mc-wl-btn" data-mc-wishlist aria-label="Save to wishlist" onclick="this.classList.toggle('is-active')">
                        <span class="mc-wl-btn__icons" aria-hidden="true">
                          {% render 'icon', name: 'heart', class: 'mc-wl-btn__outline' %}
                          {% render 'icon', name: 'heart-filled', class: 'mc-wl-btn__filled' %}
                        </span>
                      </button>
                    </div>
                  </div>
                  <div class="mc-card__body">
                    <p class="mc-card__vendor">SAMPLE BRAND</p>
                    <h3 class="mc-card__title">
                      <a href="{{ routes.collections_url }}/haircare">Nourishing shampoo & conditioner set</a>
                    </h3>
                    <div class="mc-card__price">
                      <span class="mc-price">₹899</span>
                    </div>
                  </div>
                </article>
              </li>
            {%- elsif sec_anchor contains 'gift' or sec_eyebrow contains 'gift' or sec_title contains 'joy' -%}
              {%- comment -%} Sample card 1: Festive gift hamper box {%- endcomment -%}
              <li>
                <article class="mc-card">
                  <div class="mc-card__media-wrap">
                    <a class="mc-card__media" href="{{ routes.collections_url }}/gift-articles" aria-label="Festive gift hamper box">
                      <img class="mc-card__img" src="{{ 'dept-gifts.jpg' | asset_url }}" alt="Festive gift hamper box" width="600" height="600" loading="eager">
                    </a>
                    <div class="mc-card__badges">
                      <span class="mc-badge mc-badge--sale">13% OFF</span>
                    </div>
                    <div class="mc-card__wishlist">
                      <button type="button" class="mc-wl-btn" data-mc-wishlist aria-label="Save to wishlist" onclick="this.classList.toggle('is-active')">
                        <span class="mc-wl-btn__icons" aria-hidden="true">
                          {% render 'icon', name: 'heart', class: 'mc-wl-btn__outline' %}
                          {% render 'icon', name: 'heart-filled', class: 'mc-wl-btn__filled' %}
                        </span>
                      </button>
                    </div>
                  </div>
                  <div class="mc-card__body">
                    <p class="mc-card__vendor">SAMPLE BRAND</p>
                    <h3 class="mc-card__title">
                      <a href="{{ routes.collections_url }}/gift-articles">Festive gift hamper box</a>
                    </h3>
                    <div class="mc-card__price">
                      <span class="mc-price mc-price--sale">₹1,299 <s class="mc-price__compare">₹1,499</s></span>
                    </div>
                  </div>
                </article>
              </li>
              {%- comment -%} Sample card 2: Gold-tone bangle set {%- endcomment -%}
              <li>
                <article class="mc-card">
                  <div class="mc-card__media-wrap">
                    <a class="mc-card__media" href="{{ routes.collections_url }}/imitation-jewellery" aria-label="Gold-tone bangle set">
                      <img class="mc-card__img" src="{{ 'dept-jewellery.jpg' | asset_url }}" alt="Gold-tone bangle set" width="600" height="600" loading="eager">
                    </a>
                    <div class="mc-card__wishlist">
                      <button type="button" class="mc-wl-btn" data-mc-wishlist aria-label="Save to wishlist" onclick="this.classList.toggle('is-active')">
                        <span class="mc-wl-btn__icons" aria-hidden="true">
                          {% render 'icon', name: 'heart', class: 'mc-wl-btn__outline' %}
                          {% render 'icon', name: 'heart-filled', class: 'mc-wl-btn__filled' %}
                        </span>
                      </button>
                    </div>
                  </div>
                  <div class="mc-card__body">
                    <p class="mc-card__vendor">SAMPLE BRAND</p>
                    <h3 class="mc-card__title">
                      <a href="{{ routes.collections_url }}/imitation-jewellery">Gold-tone bangle set</a>
                    </h3>
                    <div class="mc-card__price">
                      <span class="mc-price">₹549</span>
                    </div>
                  </div>
                </article>
              </li>
            {%- else -%}
              {%- comment -%} Sample card 1: Hydrating gel face wash, 100 ml {%- endcomment -%}
              <li>
                <article class="mc-card">
                  <div class="mc-card__media-wrap">
                    <a class="mc-card__media" href="{{ routes.collections_url }}/skincare" aria-label="Hydrating gel face wash, 100 ml">
                      <img class="mc-card__img" src="{{ 'dept-beauty.jpg' | asset_url }}" alt="Hydrating gel face wash, 100 ml" width="600" height="600" loading="eager">
                    </a>
                    <div class="mc-card__wishlist">
                      <button type="button" class="mc-wl-btn" data-mc-wishlist aria-label="Save to wishlist" onclick="this.classList.toggle('is-active')">
                        <span class="mc-wl-btn__icons" aria-hidden="true">
                          {% render 'icon', name: 'heart', class: 'mc-wl-btn__outline' %}
                          {% render 'icon', name: 'heart-filled', class: 'mc-wl-btn__filled' %}
                        </span>
                      </button>
                    </div>
                  </div>
                  <div class="mc-card__body">
                    <p class="mc-card__vendor">SAMPLE BRAND</p>
                    <h3 class="mc-card__title">
                      <a href="{{ routes.collections_url }}/skincare">Hydrating gel face wash, 100 ml</a>
                    </h3>
                    <div class="mc-card__price">
                      <span class="mc-price">₹299</span>
                    </div>
                  </div>
                </article>
              </li>
              {%- comment -%} Sample card 2: Matte lipstick trio (19% OFF) {%- endcomment -%}
              <li>
                <article class="mc-card">
                  <div class="mc-card__media-wrap">
                    <a class="mc-card__media" href="{{ routes.collections_url }}/beauty-makeup" aria-label="Matte lipstick trio">
                      <img class="mc-card__img" src="{{ 'dept-makeup.jpg' | asset_url }}" alt="Matte lipstick trio" width="600" height="600" loading="eager">
                    </a>
                    <div class="mc-card__badges">
                      <span class="mc-badge mc-badge--sale">19% OFF</span>
                    </div>
                    <div class="mc-card__wishlist">
                      <button type="button" class="mc-wl-btn" data-mc-wishlist aria-label="Save to wishlist" onclick="this.classList.toggle('is-active')">
                        <span class="mc-wl-btn__icons" aria-hidden="true">
                          {% render 'icon', name: 'heart', class: 'mc-wl-btn__outline' %}
                          {% render 'icon', name: 'heart-filled', class: 'mc-wl-btn__filled' %}
                        </span>
                      </button>
                    </div>
                  </div>
                  <div class="mc-card__body">
                    <p class="mc-card__vendor">SAMPLE BRAND</p>
                    <h3 class="mc-card__title">
                      <a href="{{ routes.collections_url }}/beauty-makeup">Matte lipstick trio</a>
                    </h3>
                    <div class="mc-card__price">
                      <span class="mc-price mc-price--sale">₹649 <s class="mc-price__compare">₹799</s></span>
                    </div>
                  </div>
                </article>
              </li>
            {%- endif -%}
          {%- endif -%}
        </ul>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Edit story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Beauty & Skincare Edit"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Gentle routines for every skin"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Cleansers, serums, moisturisers and sunscreens chosen from the brands on our shelves."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story image (optional)",
      "info": "Uses a bundled editorial placeholder until an image is picked."
    },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Bundled placeholder (when no image picked)",
      "options": [
        { "value": "editorial-skincare.jpg", "label": "Editorial skincare" },
        { "value": "dept-innerwear.jpg", "label": "Hosiery & innerwear" },
        { "value": "dept-gifts.jpg", "label": "Gift articles" },
        { "value": "dept-makeup.jpg", "label": "Beauty & makeup" },
        { "value": "dept-haircare.jpg", "label": "Haircare" },
        { "value": "dept-kids.jpg", "label": "Toys & kids" },
        { "value": "dept-jewellery.jpg", "label": "Imitation jewellery" },
        { "value": "dept-tools.jpg", "label": "Accessories & grooming" }
      ],
      "default": "editorial-skincare.jpg"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background tone",
      "options": [
        { "value": "paper", "label": "Paper (white)" },
        { "value": "warm", "label": "Warm" },
        { "value": "cream", "label": "Cream" },
        { "value": "blush", "label": "Blush" }
      ],
      "default": "cream"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection for the 2 product cards (optional)",
      "info": "Cards render only when this collection has products. Nothing is invented."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "HTML anchor id (optional)"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "A product type (e.g. Serums) or a brand (e.g. Cetaphil)."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)",
          "info": "Without a link the chip renders as a static pill."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Edit story",
      "blocks": [
        { "type": "chip" },
        { "type": "chip" },
        { "type": "chip" },
        { "type": "chip" }
      ]
    }
  ]
}
{% endschema %}
