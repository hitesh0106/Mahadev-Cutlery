{%- comment -%}
  Edit story — split editorial section (image + eyebrow/title/text + chip
  pills + TWO independent product cards). Three instances in the reference
  design: Beauty & Skincare, Hosiery & Innerwear, Gifts/Toys/Jewellery.

  Product Card 1 and Product Card 2 each have their OWN independent
  collection picker. The merchant can select a different collection for
  each card in the Theme Editor.

  Chips: label + optional collection or link; without a destination the
  chip is a static pill (never a dead button).

  Product cards render only when a collection with products is picked.
  Nothing is invented.
{%- endcomment -%}
{%- liquid
  assign es_has_content = false
  if section.settings.eyebrow != blank or section.settings.title != blank
    assign es_has_content = true
  endif
  assign es_rendered = 0
  for block in section.blocks
    if block.type == 'chip' and block.settings.label != blank
      assign es_rendered = es_rendered | plus: 1
    endif
  endfor
-%}
{%- if es_has_content -%}
  {%- liquid
    case section.settings.tone
      when 'warm'
        assign es_tone_class = 'mc-section--soft'
      when 'cream'
        assign es_tone_class = 'mc-section--cream'
      when 'blush'
        assign es_tone_class = 'mc-section--blush'
      else
        assign es_tone_class = ''
    endcase
  -%}
  <section class="mc-section {{ es_tone_class }} mc-edit{% if section.settings.image_side == 'right' %} mc-edit--right{% endif %}" id="{{ section.settings.anchor_id | default: section.id }}" data-testid="edit-section">
    <div class="mc-container mc-edit__inner">
      <div class="mc-edit__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag:
            loading: 'eager',
            sizes: '(min-width: 990px) 45vw, 100vw',
            widths: '400, 600, 900',
            class: 'mc-edit__img',
            alt: section.settings.image.alt | default: section.settings.title
          }}
        {%- else -%}
          <img class="mc-edit__img" src="{{ section.settings.fallback_image | default: 'editorial-skincare.jpg' | asset_url }}" alt="{{ section.settings.title | escape }}" loading="eager" width="900" height="1125">
        {%- endif -%}
      </div>

      <div class="mc-edit__body">
        <div class="mc-edit__copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="mc-eyebrow">— {{ section.settings.eyebrow | escape | upcase }}</p>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="mc-edit__title">{{ section.settings.title | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="mc-edit__text">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>

        {%- if es_rendered > 0 -%}
          <div class="mc-edit__chips">
            {%- for block in section.blocks -%}
              {%- if block.type != 'chip' -%}{%- continue -%}{%- endif -%}
              {%- assign es_label = block.settings.label -%}
              {%- if es_label == blank -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign chip_href = ''
                if block.settings.collection != blank
                  assign chip_href = block.settings.collection.url
                elsif block.settings.link != blank
                  assign chip_href = block.settings.link
                endif
              -%}
              {%- if chip_href != blank -%}
                <a class="mc-chip" href="{{ chip_href }}" {{ block.shopify_attributes }}>{{ es_label | escape }}</a>
              {%- else -%}
                <span class="mc-chip mc-chip--static" {{ block.shopify_attributes }}>{{ es_label | escape }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} Product Cards — each has its own independent collection or product {%- endcomment -%}
        {%- liquid
          assign card1_collection = section.settings.collection_1
          assign card2_collection = section.settings.collection_2
          assign card1_product = section.settings.product_1
          if card1_product == blank and card1_collection != blank and card1_collection.products_count > 0
            assign card1_product = card1_collection.products.first
          endif
          assign card2_product = section.settings.product_2
          if card2_product == blank and card2_collection != blank and card2_collection.products_count > 0
            assign card2_product = card2_collection.products.first
          endif

          assign has_card1 = false
          assign has_card2 = false
          if card1_product != blank
            assign has_card1 = true
          endif
          if card2_product != blank
            assign has_card2 = true
          endif
        -%}

        {%- if has_card1 or has_card2 -%}
          <ul class="mc-edit__products">
            {%- if has_card1 -%}
              <li>
                {% render 'product-card', card_product: card1_product, show_vendor: true, reveal: false %}
              </li>
            {%- endif -%}
            {%- if has_card2 -%}
              <li>
                {% render 'product-card', card_product: card2_product, show_vendor: true, reveal: false %}
              </li>
            {%- endif -%}
          </ul>
        {%- elsif request.design_mode -%}
          <div class="mc-edit__editor-empty" style="padding:16px 20px;margin-top:24px;border:1px dashed var(--mc-border);background:var(--mc-bg);border-radius:4px;font-size:13px;color:var(--mc-ink-soft);text-align:center;">
            <p style="margin:0 0 6px;font-weight:600;color:var(--mc-ink);">Story Product Cards (Editor Preview)</p>
            <p style="margin:0;">Select a collection or product for Card 1 and Card 2 in the section settings. Product cards will only display on the live store when configured.</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Edit story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Beauty & Skincare Edit"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Gentle routines for every skin"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Cleansers, serums, moisturisers and sunscreens chosen from the brands on our shelves."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story image (optional)",
      "info": "Uses a bundled editorial placeholder until an image is picked."
    },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Bundled placeholder (when no image picked)",
      "options": [
        { "value": "editorial-skincare.jpg", "label": "Editorial skincare" },
        { "value": "dept-innerwear.jpg", "label": "Hosiery & innerwear" },
        { "value": "dept-gifts.jpg", "label": "Gift articles" },
        { "value": "dept-makeup.jpg", "label": "Beauty & makeup" },
        { "value": "dept-haircare.jpg", "label": "Haircare" },
        { "value": "dept-kids.jpg", "label": "Toys & kids" },
        { "value": "dept-jewellery.jpg", "label": "Imitation jewellery" },
        { "value": "dept-tools.jpg", "label": "Accessories & grooming" }
      ],
      "default": "editorial-skincare.jpg"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background tone",
      "options": [
        { "value": "paper", "label": "Paper (white)" },
        { "value": "warm", "label": "Warm" },
        { "value": "cream", "label": "Cream" },
        { "value": "blush", "label": "Blush" }
      ],
      "default": "cream"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Product Card 1"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection for card 1",
      "info": "Select the collection for the first product card. The first product from this collection will be displayed."
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Or specific product for card 1 (optional)",
      "info": "Overrides the collection selection when set."
    },
    {
      "type": "header",
      "content": "Product Card 2"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection for card 2",
      "info": "Select the collection for the second product card. Independent from card 1 — choose a different collection if needed."
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Or specific product for card 2 (optional)",
      "info": "Overrides the collection selection when set."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "HTML anchor id (optional)"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip / tag",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "A product type (e.g. Serums) or a brand (e.g. Cetaphil)."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (optional)",
          "info": "When picked, the chip links to this collection. Takes priority over the custom link below."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (fallback)",
          "info": "Used when no collection is selected above. Without any link the chip renders as a static pill."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Edit story",
      "blocks": [
        { "type": "chip" },
        { "type": "chip" },
        { "type": "chip" },
        { "type": "chip" }
      ]
    }
  ]
}
{% endschema %}
