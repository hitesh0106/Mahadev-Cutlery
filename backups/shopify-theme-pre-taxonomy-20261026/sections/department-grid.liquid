{%- comment -%}
  Department grid — blocks of collection picker cards.
  Renders ONLY collections explicitly picked by the merchant (never auto-generates),
  and hides entirely when no blocks are configured. NO kitchenware/cutlery department.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section class="mc-section mc-departments">
    <div class="mc-container">
      {%- if section.settings.heading != blank -%}
        <h2 class="mc-section__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="mc-grid mc-grid--departments">
        {%- for block in section.blocks -%}
          {%- assign dept_collection = block.settings.collection -%}
          {%- if dept_collection != blank -%}
            {%- assign dept_title = block.settings.title | default: dept_collection.title -%}
            {%- assign dept_img = block.settings.image | default: dept_collection.image -%}
            {%- assign dept_alt = dept_title -%}
            {%- if dept_img != blank and dept_img.alt != blank -%}
              {%- assign dept_alt = dept_img.alt -%}
            {%- endif -%}
            <a
              class="mc-dept-card mc-reveal"
              href="{{ dept_collection.url }}"
              {{ block.shopify_attributes }}
            >
              <span class="mc-dept-card__media">
                {%- if dept_img != blank -%}
                  {{ dept_img | image_url: width: 600 | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 300px, (min-width: 750px) 33vw, 50vw',
                    widths: '300, 450, 600',
                    class: 'mc-dept-card__img',
                    alt: dept_alt
                  }}
                {%- else -%}
                  <span class="mc-dept-card__placeholder" aria-hidden="true">{% render 'icon', name: 'gift', size: 36 %}</span>
                {%- endif -%}
              </span>
              <span class="mc-dept-card__body">
                <span class="mc-dept-card__title">{{ dept_title | escape }}</span>
                {%- if block.settings.rule_text != blank -%}
                  <span class="mc-dept-card__rule">{{ block.settings.rule_text | escape }}</span>
                {%- endif -%}
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="mc-container mc-section">
    <p class="mc-empty-note">{{ 'departments.empty_note' | t }}</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Department grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Department"
    }
  ],
  "blocks": [
    {
      "type": "department",
      "name": "Department card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Only picked collections are rendered. Example departments: Beauty & Skincare, Makeup, Haircare, Hosiery & Innerwear, Kids & Toys, Gift Articles, Imitation Jewellery, Beauty Tools & Grooming, Accessories & More."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override (optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override (optional)"
        },
        {
          "type": "text",
          "id": "rule_text",
          "label": "Small note (optional)",
          "info": "e.g. a brand rule like “Zoiro — men's innerwear only”."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Department grid",
      "blocks": []
    }
  ]
}
{% endschema %}
