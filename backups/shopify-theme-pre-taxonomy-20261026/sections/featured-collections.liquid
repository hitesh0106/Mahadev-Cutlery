{%- comment -%}
  Featured collections — heading + grid of collection picker cards (blocks).
  Renders only picked collections; hides when no blocks.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section class="mc-section mc-featured-collections">
    <div class="mc-container">
      {%- if section.settings.heading != blank -%}
        <h2 class="mc-section__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="mc-grid mc-grid--collections">
        {%- for block in section.blocks -%}
          {%- assign fc_collection = block.settings.collection -%}
          {%- if fc_collection != blank -%}
            {%- assign fc_title = block.settings.title | default: fc_collection.title -%}
            {%- assign fc_alt = fc_title -%}
            {%- if fc_collection.image != blank and fc_collection.image.alt != blank -%}
              {%- assign fc_alt = fc_collection.image.alt -%}
            {%- endif -%}
            <a class="mc-collection-card mc-reveal" href="{{ fc_collection.url }}" {{ block.shopify_attributes }}>
              <span class="mc-collection-card__media">
                {%- if fc_collection.image != blank -%}
                  {{ fc_collection.image | image_url: width: 600 | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 33vw, 50vw',
                    widths: '300, 450, 600',
                    class: 'mc-collection-card__img',
                    alt: fc_alt
                  }}
                {%- else -%}
                  <span class="mc-collection-card__placeholder" aria-hidden="true">{% render 'icon', name: 'gift', size: 36 %}</span>
                {%- endif -%}
              </span>
              <span class="mc-collection-card__title">{{ fc_title | escape }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Featured collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collections"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collections",
      "blocks": []
    }
  ]
}
{% endschema %}
