{%- comment -%}
  Announcement bar. Text falls back to the locale "announcement.note" when the
  setting is empty. Enable checkbox off -> section renders nothing.
{%- endcomment -%}
{%- if section.settings.show -%}
  {%- assign ann_text = section.settings.message -%}
  {%- if ann_text == blank -%}
    {%- assign ann_text = 'announcement.note' | t -%}
  {%- endif -%}
  <div
    class="mc-announcement"
    style="background: {{ section.settings.bg }}; color: {{ section.settings.text }};"
    {% if section.settings.animate %}data-mc-reveal-bar{% endif %}
  >
    <div class="mc-announcement__inner mc-container">
      {%- if section.settings.link != blank -%}
        <a class="mc-announcement__link" href="{{ section.settings.link }}">{{ ann_text | escape }}</a>
      {%- else -%}
        <p class="mc-announcement__text">{{ ann_text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "info": "Leave empty to use the store's default announcement text.",
      "default": ""
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#B8875A"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
