{%- comment -%}
  Hero banner: image (optional) + heading + subtitle + CTA.
  Without an image it falls back to the warm soft background — no invented imagery.
  Hidden when heading, subtitle and image are all empty.
{%- endcomment -%}
{%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.image != blank -%}
  {%- if section.settings.image != blank -%}
    {%- assign hero_alt = section.settings.image.alt | default: section.settings.heading -%}
  {%- endif -%}
  <section class="mc-hero">
    <div class="mc-hero__inner mc-container">
      <div class="mc-hero__content mc-reveal">
        {%- if section.settings.heading != blank -%}
          <h1 class="mc-hero__heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="mc-hero__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
          <a class="mc-btn mc-btn--primary mc-hero__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.image != blank -%}
        <div class="mc-hero__media mc-reveal">
          {{ section.settings.image | image_url: width: 1200 | image_tag:
            loading: 'eager',
            sizes: '(min-width: 990px) 50vw, 100vw',
            widths: '400, 600, 800, 1000, 1200',
            class: 'mc-hero__img',
            alt: hero_alt
          }}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background/side image (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtful gifts & everyday essentials"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Beauty, hosiery, kids, jewellery and more — from our store in Vastral, Ahmedabad."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
