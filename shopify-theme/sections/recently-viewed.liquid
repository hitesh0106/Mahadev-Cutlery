{%- comment -%}
  Recently viewed strip (used on the product template). wishlist.js fills the list from
  localStorage (mc_recently_viewed_v1), excluding the current handle via data-mc-current-handle.
  Hidden entirely by JS when there is nothing to show — never shows fake products.
{%- endcomment -%}
<section class="mc-section mc-recently-viewed" data-mc-recently-viewed data-mc-current-handle="{{ product.handle | default: '' }}" hidden>
  <div class="mc-container">
    <h2 class="mc-section__heading mc-section__heading--sub">{{ 'products.recently_viewed_title' | t }}</h2>
    <div class="mc-grid mc-grid--products" data-mc-recently-viewed-list></div>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "settings": [],
  "presets": [
    {
      "name": "Recently viewed"
    }
  ]
}
{% endschema %}
