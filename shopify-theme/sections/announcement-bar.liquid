{%- comment -%}
  Announcement bar — dark ink bar with TWO rotating messages, prev/next
  arrows and auto-advance every 5s (paused on hover, disabled for
  prefers-reduced-motion) — reference-exact behaviour of the approved design.
{%- endcomment -%}
{%- liquid
  assign ann_enabled = section.settings.show
  assign ann_1 = section.settings.message_1
  assign ann_2 = section.settings.message_2
  if ann_1 == blank and ann_2 == blank
    assign ann_1 = 'announcement.note' | t
  endif
-%}
{%- if ann_enabled -%}
  <div
    class="mc-announcement mc-announcement--rotator"
    style="background: {{ section.settings.bg }}; color: {{ section.settings.text }};"
    data-mc-ann
    {% unless section.settings.autoplay %}data-mc-ann-noauto{% endunless %}
  >
    <div class="mc-announcement__inner mc-announcement__inner--rotator">
      <button type="button" class="mc-announcement__arrow" data-mc-ann-prev aria-label="{{ 'general.previous' | t }}">
        <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <div class="mc-announcement__stack" aria-live="polite">
        {%- if ann_1 != blank -%}
          <p class="mc-announcement__slide is-active" data-mc-ann-slide>{{ ann_1 | escape }}</p>
        {%- endif -%}
        {%- if ann_2 != blank -%}
          <p class="mc-announcement__slide" data-mc-ann-slide>{{ ann_2 | escape }}</p>
        {%- endif -%}
      </div>

      <button type="button" class="mc-announcement__arrow" data-mc-ann-next aria-label="{{ 'general.next' | t }}">
        <svg class="mc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <script>
    (function () {
      'use strict';
      var bar = document.currentScript.previousElementSibling;
      if (!bar || bar.dataset.mcAnnReady) return;
      bar.dataset.mcAnnReady = '1';
      var slides = bar.querySelectorAll('[data-mc-ann-slide]');
      if (slides.length < 2) return;
      var index = 0;
      var paused = false;
      var auto = !bar.hasAttribute('data-mc-ann-noauto') && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function show(next) {
        slides[index].classList.remove('is-active');
        index = (next + slides.length) % slides.length;
        slides[index].classList.add('is-active');
      }
      bar.querySelector('[data-mc-ann-prev]').addEventListener('click', function () { show(index - 1); });
      bar.querySelector('[data-mc-ann-next]').addEventListener('click', function () { show(index + 1); });
      bar.addEventListener('mouseenter', function () { paused = true; });
      bar.addEventListener('mouseleave', function () { paused = false; });
      if (auto) setInterval(function () { if (!paused) show(index + 1); }, 5000);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "message_1",
      "label": "Message 1",
      "default": "Beauty, innerwear, gifts & more — curated in Ahmedabad"
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Message 2",
      "default": "Explore original products from brands you trust"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rotate messages automatically",
      "default": true
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#20201E"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text color",
      "default": "#FAF8F5"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
