{%- comment -%}
  Search page: search form + results grid (products) + page/article results + count + empty state.
{%- endcomment -%}
<section class="mc-section mc-search">
  <div class="mc-container">
    <h1 class="mc-section__heading">{{ 'search.title' | t }}</h1>

    <form class="mc-search-form" action="{{ routes.search_url }}" method="get" role="search">
      <input
        type="search"
        class="mc-input"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        aria-label="{{ 'search.placeholder' | t }}"
      >
      <button type="submit" class="mc-btn mc-btn--primary">{{ 'general.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 12 -%}
        {%- if search.results_count > 0 -%}
          <p class="mc-search__count">{{ 'search.results_with_count' | t: count: search.results_count, terms: search.terms }}</p>

          <div class="mc-grid mc-grid--products">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', card_product: item %}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- assign mc_pages = '' -%}
          {%- for item in search.results -%}
            {%- if item.object_type == 'page' or item.object_type == 'article' -%}
              {%- capture mc_pages -%}
                {{ mc_pages }}
                <a class="mc-search__page" href="{{ item.url }}">
                  <span class="mc-search__page-title">{{ item.title | escape }}</span>
                  {%- if item.content != blank -%}
                    <span class="mc-search__page-snippet">{{ item.content | strip_html | truncate: 140 }}</span>
                  {%- endif -%}
                </a>
              {%- endcapture -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if mc_pages != blank -%}
            <div class="mc-search__pages">
              <h2 class="mc-section__heading mc-section__heading--sub">{{ 'search.pages' | t }}</h2>
              {{ mc_pages }}
            </div>
          {%- endif -%}

          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <div class="mc-empty-state">
            <p>{{ 'search.empty' | t: terms: search.terms }}</p>
            <a class="mc-btn mc-btn--secondary" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty_cta' | t }}</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
