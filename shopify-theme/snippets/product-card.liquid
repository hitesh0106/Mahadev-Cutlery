{%- comment -%}
  Renders a product card for grids (featured products, related, search, collection, gift finder fallback markup).
  Accepts:
  - card_product: {Object} Product (required)
  - show_vendor: {Boolean} (optional) overrides settings.show_vendor
  - reveal: {Boolean} (optional) adds .mc-reveal animation class, default true
{%- endcomment -%}
{%- if card_product != blank -%}
{%- liquid
  assign pc_show_vendor = show_vendor
  if pc_show_vendor == nil
    assign pc_show_vendor = settings.show_vendor
  endif
  assign pc_reveal = reveal
  if pc_reveal == nil
    assign pc_reveal = true
  endif
-%}
<article class="mc-card{% if pc_reveal %} mc-reveal{% endif %}">
  <a class="mc-card__media" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
    {%- if card_product.featured_image -%}
      <img
        class="mc-card__img"
        src="{{ card_product.featured_image | image_url: width: 600 }}"
        srcset="{{ card_product.featured_image | image_url: width: 300 }} 300w, {{ card_product.featured_image | image_url: width: 600 }} 600w, {{ card_product.featured_image | image_url: width: 900 }} 900w"
        sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
        alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}"
        width="600"
        height="750"
        loading="lazy"
      >
    {%- else -%}
      <span class="mc-card__placeholder" aria-hidden="true">{% render 'icon', name: 'gift', size: 40 %}</span>
    {%- endif -%}
    <span class="mc-card__badges">
      {%- if card_product.tags contains 'sample' -%}
        <span class="mc-badge mc-badge--sample">{{ 'products.sample_note' | t }}</span>
      {%- endif -%}
      {%- unless card_product.available -%}
        <span class="mc-badge mc-badge--soldout">{{ 'cart.sold_out' | t }}</span>
      {%- endunless -%}
    </span>
  </a>
  <div class="mc-card__body">
    {%- if pc_show_vendor and card_product.vendor != blank -%}
      <p class="mc-card__vendor">{{ card_product.vendor }}</p>
    {%- endif -%}
    <h3 class="mc-card__title">
      <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
    </h3>
    {% render 'price', product: card_product, class: 'mc-card__price' %}
  </div>
  <div class="mc-card__actions">
    {% render 'wishlist-button', product: card_product %}
  </div>
</article>
{%- endif -%}
